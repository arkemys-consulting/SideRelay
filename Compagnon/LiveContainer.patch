+    @objc private func addToHomeScreen() {
+        guard viewIfLoaded?.window != nil, presentedViewController == nil,
+              bannerView.homeScreenButton.isEnabled else { return }
+        let visibleApps = DataManager.shared.model.apps.filter { !$0.uiIsHidden && $0.appInfo.relativeBundlePath != nil }
+        guard !visibleApps.isEmpty else { return }
+        let connection = SideRelayConnection()
+        bannerView.homeScreenButton.isEnabled = false
+        Task {
+            defer { self.bannerView.homeScreenButton.isEnabled = true }
+            do {
+                let apps = self.homeScreenApps(visibleApps, includeIcons: false)
+                let state = try await connection.homeScreenProfileState(apps: apps)
+                self.showHomeScreenProfile(state, apps: visibleApps, connection: connection)
+            } catch {
+                self.showError("Could not check the SideRelay profile. Keep SideRelay open on your Mac and check Tailscale on both devices.")
+            }
+        }
+    }
+
+    private func homeScreenApps(_ apps: [LCAppModel], includeIcons: Bool) -> [SideRelayConnection.HomeScreenApp] {
+        apps.compactMap { app in
+            guard let bundle = app.appInfo.relativeBundlePath else { return nil }
+            return .init(name: app.displayName, bundle: bundle, folder: app.uiSelectedContainer?.folderName,
+                         installedAt: app.appInfo.installationDate?.timeIntervalSince1970,
+                         icon: includeIcons ? homeScreenIconData(app.appInfo.iconIsDarkIcon(false)) : nil)
+        }
+    }
+
+    private func showHomeScreenProfile(_ state: SideRelayConnection.HomeScreenProfileState,
+                                      apps: [LCAppModel], connection: SideRelayConnection) {
+        guard viewIfLoaded?.window != nil, presentedViewController == nil else { return }
+        let restoring = state != .missing
+        let message: String
+        if restoring {
+            message = "Recreate all SideRelay Home Screen shortcuts, including any you removed. Their positions may change. After downloading, go to Settings → Profile Downloaded → Install."
+        } else {
+            message = "One profile adds shortcuts for all visible LiveContainer apps. After downloading, go to Settings → Profile Downloaded → Install."
+        }
+        let alert = UIAlertController(
+            title: restoring ? "Restore Home Screen Shortcuts" : "Add to Home Screen",
+            message: message,
+            preferredStyle: .alert
+        )
+        alert.addAction(UIAlertAction(title: "Cancel", style: .cancel))
+        alert.addAction(UIAlertAction(title: "Download Profile", style: .default) { [weak self] _ in
+            self?.downloadHomeScreenProfile(apps, connection: connection, restoring: restoring)
+        })
+        present(alert, animated: true)
+    }
+
+    private func downloadHomeScreenProfile(_ apps: [LCAppModel], connection: SideRelayConnection, restoring: Bool) {
+        bannerView.homeScreenButton.isEnabled = false
+        Task { [weak self] in
+            guard let self else { return }
+            defer { self.bannerView.homeScreenButton.isEnabled = true }
+            do {
+                let url = try await connection.prepareHomeScreenShortcuts(
+                    apps: self.homeScreenApps(apps, includeIcons: true), restoring: restoring
+                )
+                if !(await UIApplication.shared.open(url)) {
+                    self.showError("Could not open the SideRelay profile download in your browser.")
+                }
+            } catch {
+                self.showError("Could not prepare the SideRelay profile. Keep SideRelay open on your Mac and check Tailscale on both devices.")
+            }
+        }
+    }
+
+    private func homeScreenIconData(_ icon: UIImage?) -> Data? {
+        let square = CGSize(width: 180, height: 180)
+        let format = UIGraphicsImageRendererFormat()
+        format.scale = 1
+        return UIGraphicsImageRenderer(size: square, format: format).pngData { _ in
+            if let icon, icon.size.width > 0, icon.size.height > 0 {
+                let scale = min(square.width / icon.size.width, square.height / icon.size.height)
+                let size = CGSize(width: icon.size.width * scale, height: icon.size.height * scale)
+                icon.draw(in: CGRect(x: (square.width - size.width) / 2,
+                                     y: (square.height - size.height) / 2,
+                                     width: size.width, height: size.height))
+            } else {
+                UIColor.systemIndigo.setFill()
+                UIRectFill(CGRect(origin: .zero, size: square))
+                UIImage(systemName: "square.grid.2x2")?
+                    .withTintColor(.white, renderingMode: .alwaysOriginal)
+                    .draw(in: CGRect(x: 35, y: 35, width: 110, height: 110))
+            }
+        }
+    }
