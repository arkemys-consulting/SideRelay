+private enum StoreCuratedSource {
+    case sideStore, github
+
+    init?(url: URL) {
+        switch (url.host, url.path) {
+        case ("community-apps.sidestore.io", "/sidecommunity.json"): self = .sideStore
+        case ("kb01111.github.io", "/Sideload-Sources/source.json"): self = .github
+        default: return nil
+        }
+    }
+
+    private static let sideStoreApps: Set<String> = [
+        "org.ppsspp.ppsspp", "com.neo.countdown", "com.stik.stiknes",
+        "com.libretro.retroarchios11", "app.ish.ish", "net.nerd.inds",
+        "com.virtualapplications.play", "com.litchie.idosgames", "com.adriweb.firebird-emu",
+        "com.yoshisuga.activegs", "at.tpau.ready", "com.example.mame4ios",
+        "com.zurac.oldos", "com.xitrix.itorrent2", "org.scummvm.scummvm",
+        "net.namedfork.minivmac", "com.wh0ba.xpatcher", "eu.vcmi.vcmiclient"
+    ]
+
+    private static let upstreamRepos: [String: Set<String>] = [
+        "com.rileytestut.delta": ["rileytestut/delta"],
+        "org.provenance-emu.provenance": ["provenance-emu/provenance"],
+        "com.provenance-emu.provenance.alpha": ["provenance-emu/provenance"],
+        "com.utmapp.utm": ["utmapp/utm"],
+        "com.utmapp.utm-se": ["utmapp/utm"],
+        "org.ppsspp.ppsspp-free": ["hrydgard/ppsspp"],
+        "com.jevon.pocket8": ["jevonlipsey/pico-ios"],
+        "oss.krtirtho.spotube": ["krtirtho/spotube", "team-spotube/spotube"],
+        "org.spotube.spotube.spotube": ["team-spotube/spotube"],
+        "com.paperback.ios": ["paperback-ios/app"],
+        "com.example.mirarr": ["mirarr-app/mirarr"],
+        "app.molinete.aerio": ["jonzey231/aeriotv"]
+    ]
+
+    func includes(_ app: AltStoreSourceApp, release: AltStoreSourceAppVersion) -> Bool {
+        let bundle = app.bundleIdentifier.lowercased()
+        switch self {
+        case .sideStore:
+            return Self.sideStoreApps.contains(bundle)
+        case .github:
+            let url = release.downloadURL
+            let parts = url.pathComponents.filter { $0 != "/" }
+            guard url.host == "github.com", parts.count == 6, parts[2] == "releases",
+                  parts[3] == "download", url.pathExtension.lowercased() == "ipa" else { return false }
+            let repository = parts.prefix(2).joined(separator: "/").lowercased()
+            return Self.upstreamRepos[bundle]?.contains(repository) == true
+        }
+    }
+}
+
+private struct StoreListing: Identifiable {
+    let id: String
+    let primary: StoreEdition
+    let editions: [StoreEdition]
+    let screenshots: [StoreScreenshot]
+
+    var app: AltStoreSourceApp { primary.app }
+    var subtitle: String { primary.subtitle }
+    var source: String { primary.source }
+    var release: AltStoreSourceAppVersion { primary.release }
+    var isCompatible: Bool { primary.isCompatible && !primary.isRestricted }
+    var category: StoreCategory { StoreCategory.category(for: primary) }
+
+    var publisherPage: URL? {
+        if let website = app.publisherURL { return website }
+        let url = release.downloadURL
+        let parts = url.pathComponents
+        guard url.host == "github.com", parts.count == 7, parts[3] == "releases", parts[4] == "download" else {
+            return nil
+        }
+        return URL(string: "https://github.com").map {
+            $0.appendingPathComponent(parts[1]).appendingPathComponent(parts[2])
+                .appendingPathComponent("releases").appendingPathComponent("tag").appendingPathComponent(parts[5])
+        }
+    }
+
+    var releases: [AltStoreSourceAppVersion] {
+        let candidates = app.versions + (app.latestVersion.map { [$0] } ?? [])
+        var seen = Set<URL>()
+        return candidates.sorted {
+            ($0.releaseDate ?? .distantPast) > ($1.releaseDate ?? .distantPast)
+        }.filter { seen.insert($0.downloadURL).inserted }
+    }
+
+    static func group(_ candidates: [StoreEdition]) -> [StoreListing] {
+        Dictionary(grouping: candidates, by: \.family).compactMap { id, versions in
+            let ordered = versions.sorted { a, b in
+                if a.isCompatible != b.isCompatible { return a.isCompatible }
+                if a.isRestricted != b.isRestricted { return !a.isRestricted }
+                let leftSE = a.app.bundleIdentifier.lowercased() == "com.utmapp.utm-se"
+                let rightSE = b.app.bundleIdentifier.lowercased() == "com.utmapp.utm-se"
+                if leftSE != rightSE { return leftSE }
+                if a.isPrerelease != b.isPrerelease { return !a.isPrerelease }
+                if a.isCommunity != b.isCommunity { return !a.isCommunity }
+                let leftDate = a.release.releaseDate ?? .distantPast
+                let rightDate = b.release.releaseDate ?? .distantPast
+                if leftDate != rightDate { return leftDate > rightDate }
+                if a.source != b.source { return a.source < b.source }
+                return a.id < b.id
+            }
+            var seenAssets = Set<String>()
+            var seenVersions = Set<String>()
+            let editions = ordered.filter {
+                let version = "\($0.app.bundleIdentifier.lowercased())|\($0.release.version)|\($0.release.buildVersion ?? "")"
+                return seenAssets.insert($0.id).inserted && seenVersions.insert(version).inserted
+            }
+            guard let primary = editions.first else { return nil }
+            let screenshots = ordered.first {
+                $0.app.bundleIdentifier.caseInsensitiveCompare(primary.app.bundleIdentifier) == .orderedSame &&
+                    !$0.app.screenshots.isEmpty
+            }?.app.screenshots ?? []
+            return StoreListing(id: id, primary: primary, editions: editions, screenshots: screenshots)
+        }.sorted {
+            let order = $0.app.name.localizedStandardCompare($1.app.name)
+            return order == .orderedSame ? $0.id < $1.id : order == .orderedAscending
+        }
+    }
+}
+
+private struct StoreEdition: Identifiable {
+    let app: AltStoreSourceApp
+    let source: String
+    let release: AltStoreSourceAppVersion
+    let isCommunity: Bool
+
+    var id: String { "\(app.bundleIdentifier.lowercased())|\(release.downloadURL.absoluteString)" }
+    var subtitle: String { app.subtitle ?? app.developerName ?? source }
+
+    var previewImage: URL? { (app.screenshots.first { $0.aspectRatio > 1 } ?? app.screenshots.first)?.url }
+
+    var family: String {
+        let bundle = app.bundleIdentifier.lowercased()
+        let stable = bundle.replacingOccurrences(of: #"(?:[.-](?:beta|alpha|nightly|preview|canary))+$"#,
+                                                  with: "", options: .regularExpression)
+        switch stable {
+        case "me.oatmealdome.dolphinios-njb-patreon-beta":
+            return "me.oatmealdome.dolphinios-njb"
+        case "com.utmapp.utm-se":
+            return "com.utmapp.utm"
+        case "org.provenance-emu.provenance":
+            return "com.provenance-emu.provenance"
+        case "org.ppsspp.ppsspp-free":
+            return "org.ppsspp.ppsspp"
+        case "org.spotube.spotube.spotube":
+            return "oss.krtirtho.spotube"
+        default:
+            return stable
+        }
+    }
+
+    var isPrerelease: Bool {
+        let bundle = app.bundleIdentifier.lowercased()
+        return app.isBeta || bundle.range(of: #"(?:[.-](?:beta|alpha|nightly|preview|canary))$"#,
+                                         options: .regularExpression) != nil
+            || app.name.range(of: #"(?i)\b(?:alpha|beta|nightly|preview|canary)\b"#,
+                              options: .regularExpression) != nil
+            || release.downloadURL.pathComponents.contains("nightly")
+            || release.version.range(of: #"(?i)^(?:build\b)|(?:alpha|beta|nightly|preview|canary)"#,
+                                     options: .regularExpression) != nil
+    }
+
+    var runtimeRequirement: String? {
+        switch family {
+        case "com.armsx2.ios": return "The developer recommends JIT for playable performance."
+        case "software.iridium": return "Windows games require JIT."
+        default: return nil
+        }
+    }
+
+    var isRestricted: Bool {
+        guard let host = release.downloadURL.host else { return true }
+        return host == "patreon.com" || host.hasSuffix(".patreon.com")
+    }
+
+    var isCompatible: Bool {
+        let os = ProcessInfo.processInfo.operatingSystemVersion
+        let current = [os.majorVersion, os.minorVersion, os.patchVersion]
+        if let min = release.minimumOS.flatMap(Self.versionParts),
+           Array(current.prefix(min.count)).lexicographicallyPrecedes(min) {
+            return false
+        }
+        if let max = release.maximumOS.flatMap(Self.versionParts),
+           max.lexicographicallyPrecedes(Array(current.prefix(max.count))) {
+            return false
+        }
+        return true
+    }
+
+    private static func versionParts(_ value: String) -> [Int]? {
+        let components = value.split(separator: ".", omittingEmptySubsequences: false)
+        let numbers = components.compactMap { Int($0) }
+        return (1...3).contains(components.count) && numbers.count == components.count ? numbers : nil
     }
 }
 
