+
+
+// Validate the profile Apple returned before allowing the signer to use it.
+pub fn validate_profile(
+    profile: &Profile,
+    bundle_id: &str,
+    team: &DeveloperTeam,
+    identity: &CertificateIdentity,
+    udid: Option<&str>,
+) -> Result<(), Report> {
+    use x509_cert::der::Encode;
+    let profile = ProvisioningProfile::parse(profile.encoded_profile.as_ref())?;
+    let expected = format!("{}.{bundle_id}", team.team_id);
+    if profile.entitlements().get("application-identifier").and_then(plist::Value::as_string)
+        != Some(expected.as_str()) {
+        bail!("Apple returned a provisioning profile for a different app: expected {expected}");
+    }
+
+    let cert = identity.certificate.to_der()?;
+    let includes_cert = profile.plist().get("DeveloperCertificates")
+        .and_then(plist::Value::as_array).is_some_and(|certificates| {
+            certificates.iter().any(|entry| entry.as_data() == Some(cert.as_slice()))
+        });
+    if !includes_cert {
+        bail!("Apple's provisioning profile does not include the selected signing certificate");
+    }
+    if let Some(udid) = udid {
+        let expected = udid.replace('-', "");
+        let includes_device = profile.plist().get("ProvisionedDevices")
+            .and_then(plist::Value::as_array).is_some_and(|devices| {
+                devices.iter().filter_map(plist::Value::as_string)
+                    .any(|value| value.replace('-', "").eq_ignore_ascii_case(&expected))
+            });
+        if !includes_device {
+            bail!("Apple's provisioning profile does not include this device");
+        }
+    }
+    Ok(())
+}
