+    pub fn matches_active_certificate(entry: &DevelopmentCertificate, cert: &Certificate) -> bool {
+        let validity = &cert.tbs_certificate.validity;
+        let now = std::time::SystemTime::now();
+        let serial = cert.tbs_certificate.serial_number.as_bytes().encode_hex::<String>();
+        !Self::explicitly_inactive(entry) && entry.serial_number.as_deref().is_some_and(|candidate|
+            candidate.trim_start_matches('0').eq_ignore_ascii_case(serial.trim_start_matches('0'))
+        ) && now >= validity.not_before.to_system_time()
+          && now < validity.not_after.to_system_time()
+    }
