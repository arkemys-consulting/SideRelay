+    pub async fn prepare_local_identity(&self, team: &DeveloperTeam) -> Result<(), Report> {
+        let Some((path, password)) = Self::local_archive(team)? else { return Ok(()) };
+        let der = self.certificate.to_der()?;
+        let saved = Self::read_archive(&path)?;
+        let same = saved.as_ref().and_then(|bytes| Self::decode_archive(bytes, &password))
+            .is_some_and(|(key, certs)| certs.contains(&der) && key == self.private_key);
+        let archive = if same {
+            saved.ok_or_report()?
+        } else {
+            let bytes = self.as_p12(&password).await?;
+            let temp = path.with_extension(format!("{}.tmp", uuid::Uuid::new_v4()));
+            let result = (|| -> std::io::Result<()> {
+                use std::io::Write;
+                let mut options = std::fs::OpenOptions::new();
+                options.write(true).create_new(true);
+                #[cfg(unix)]
+                {
+                    use std::os::unix::fs::OpenOptionsExt;
+                    options.mode(0o600);
+                }
+                let mut file = options.open(&temp)?;
+                file.write_all(&bytes)?;
+                file.sync_all()?;
+                std::fs::rename(&temp, &path)?;
+                #[cfg(unix)]
+                std::fs::File::open(path.parent().expect("identity directory"))?.sync_all()?;
+                Ok(())
+            })();
+            if let Err(error) = result {
+                let _ = std::fs::remove_file(&temp);
+                return Err(report!("Could not save the signing identity: {error}"));
+            }
+            bytes
+        };
+
+        #[cfg(target_os = "macos")]
+        Self::verify_keychain_identity(&path, &password, &archive, &der)?;
+        Ok(())
+    }
+
+    #[cfg(target_os = "macos")]
+    fn verify_keychain_identity(path: &std::path::Path, password: &str, archive: &[u8], cert: &[u8]) -> Result<(), Report> {
+        use security_framework::{
+            import_export::Pkcs12ImportOptions,
+            os::macos::keychain::{CreateOptions, SecKeychain},
+        };
+        let keychain_path = path.with_extension("keychain-db");
+        let keychain_password = hex::encode(Sha256::digest(format!("SideRelay Keychain:{password}")));
+        let fingerprint = hex::encode_upper(Sha1::digest(cert));
+        let _interaction = SecKeychain::disable_user_interaction()?;
+        let mut keychain = if keychain_path.exists() {
+            SecKeychain::open(&keychain_path)
+        } else {
+            CreateOptions::new().password(&keychain_password).create(&keychain_path)
+        }.map_err(|e| report!("Could not open the SideRelay signing keychain: {e}"))?;
+        keychain.unlock(Some(&keychain_password))
+            .map_err(|e| report!("Could not unlock the SideRelay signing keychain: {e}"))?;
+
+        let find_identity = || -> Result<bool, Report> {
+            let output = std::process::Command::new("/usr/bin/security")
+                .args(["find-identity", "-p", "codesigning"])
+                .arg(&keychain_path)
+                .output()
+                .map_err(|e| report!("Could not verify the SideRelay signing keychain: {e}"))?;
+            Ok(output.status.success() && String::from_utf8_lossy(&output.stdout)
+                .split_whitespace().any(|word| word == fingerprint))
+        };
+
+        if !find_identity()? {
+            Pkcs12ImportOptions::new().passphrase(password).keychain(keychain)
+                .import(archive)
+                .map_err(|e| report!("Could not import the certificate and private key into the SideRelay keychain: {e}"))?;
+        }
+        if !find_identity()? {
+            return Err(report!("The Apple development certificate or its private key is missing from the SideRelay signing keychain."));
+        }
+        Ok(())
+    }
