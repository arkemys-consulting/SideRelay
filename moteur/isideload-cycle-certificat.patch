+    fn local_archive(team: &DeveloperTeam) -> Result<Option<(std::path::PathBuf, String)>, Report> {
+        let Some(directory) = std::env::var_os("SIDERELAY_ALTSERVER_CERTIFICATES_DIR") else {
+            return Ok(None);
+        };
+        if team.team_id.is_empty() || !team.team_id.bytes().all(|byte| byte.is_ascii_alphanumeric()) {
+            return Err(report!("Invalid team identifier for the local signing identity"));
+        }
+        let secret = if let Some(path) = std::env::var_os("JAS_SECRET_KEY_FILE") { std::fs::read_to_string(path).ok() } else { std::env::var("JAS_SECRET_KEY").ok() }
+            .ok_or_else(|| report!("SideRelay service key is missing. Its signing identity cannot be opened."))?;
+        let password = hex::encode(Sha256::digest(format!("SideRelay PKCS12/{}:{secret}", team.team_id)));
+        let path = std::path::PathBuf::from(directory).join(format!("{}-siderelay.p12", team.team_id));
+        Ok(Some((path, password)))
+    }
+
+    fn read_archive(path: &std::path::Path) -> Result<Option<Vec<u8>>, Report> {
+        match std::fs::read(path) {
+            Ok(bytes) => Ok(Some(bytes)),
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(None),
+            Err(error) => Err(report!("Could not read the encrypted signing identity: {error}")),
+        }
+    }
+
+    fn decode_archive(archive: &[u8], password: &str) -> Option<(RsaPrivateKey, Vec<Vec<u8>>)> {
+        let store = p12_keystore::KeyStore::from_pkcs12(
+            archive, password, p12_keystore::Pkcs12ImportPolicy::Strict,
+        ).ok()?;
+        let (_, chain) = store.private_key_chain()?;
+        let key = RsaPrivateKey::from_pkcs8_der(chain.key().as_der()).ok()?;
+        Some((key, chain.certs().iter().map(|cert| cert.as_der().to_vec()).collect()))
+    }
+
+    fn key_matches(key: &RsaPrivateKey, cert: &Certificate) -> Result<bool, Report> {
+        let public_key = key.to_public_key().to_pkcs1_der()?;
+        Ok(cert.tbs_certificate.subject_public_key_info.subject_public_key.as_bytes() == Some(public_key.as_bytes()))
+    }
