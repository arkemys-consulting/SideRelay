+fn validate_top_shelf_group(entitlements: &Dictionary, group: &str, bundle_id: &str) -> Result<(), Report> {
+    let allowed = entitlements.get("com.apple.security.application-groups")
+        .and_then(plist::Value::as_array)
+        .is_some_and(|groups| groups.iter().any(|entry| entry.as_string() == Some(group)));
+    if !allowed {
+        bail!("Apple's provisioning profile for {bundle_id} does not include the Top Shelf App Group.");
+    }
+    Ok(())
