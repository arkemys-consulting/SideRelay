+pub(crate) fn mark_tvos(body: &mut plist::Dictionary) {
+    body.insert("DTDK_Platform".to_string(), plist::Value::String("tvos".to_string()));
+    body.insert("subPlatform".to_string(), plist::Value::String("tvOS".to_string()));
+}
