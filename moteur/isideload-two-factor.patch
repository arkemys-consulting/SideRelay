+#[cfg(test)]
+mod sms_resend_tests {
+    use super::{AppleAccount, LoginState, SmsSendOutcome};
+
+    #[test]
+    fn a_refused_sms_resend_keeps_the_selected_verification_challenge() {
+        for code in ["-28248", "-22979", "-22981"] {
+            let response = serde_json::json!({
+                "serviceErrors": [{
+                    "code": code,
+                    "title": "SMS unavailable",
+                    "message": "Use the code already received."
+                }]
+            });
+            let outcome = AppleAccount::classify_sms_send_response(400, &response.to_string(), 7)
+                .expect("Apple's service error should be readable");
+            let SmsSendOutcome::ServiceError(error) = outcome else {
+                panic!("expected a service error");
+            };
+            assert!(matches!(
+                AppleAccount::sms_send_error_state(&error, 7).unwrap(),
+                LoginState::NeedsSMS2FAVerification(7)
+            ));
+        }
+    }
+
+    #[test]
+    fn unrelated_sms_errors_still_fail_the_sign_in() {
+        let response = serde_json::json!({
+            "serviceErrors": [{
+                "code": "-99999",
+                "title": "Sign-in unavailable",
+                "message": "Try again later."
+            }]
+        });
+        let SmsSendOutcome::ServiceError(error) =
+            AppleAccount::classify_sms_send_response(400, &response.to_string(), 7).unwrap()
+        else {
+            panic!("expected a service error");
+        };
+        assert!(AppleAccount::sms_send_error_state(&error, 7).is_err());
+    }
+}
