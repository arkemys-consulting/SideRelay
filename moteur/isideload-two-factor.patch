+    fn sms_send_error_state(error: &SMSTwoFactorError, id: u32) -> Result<LoginState, Report> {
+        // A refused resend can follow an SMS Apple already sent during sign-in.
+        // Keep that challenge's number so the received code can still be tried.
+        if matches!(error.code.as_str(), "-28248" | "-22979" | "-22981") {
+            return Ok(LoginState::NeedsSMS2FAVerification(id));
+        }
+        bail!(
+            "SMS 2FA request failed (code {}): {} - {}",
+            error.code,
+            error.title,
+            error.message
+        );
+    }
