diff --git a/src/server/documents.rs b/src/server/documents.rs
new file mode 100644
index 0000000..117c9a0
--- /dev/null
+++ b/src/server/documents.rs
@@ -0,0 +1,293 @@
+use std::{path::{Path, PathBuf}, time::Duration};
+use anyhow::{ensure, Context};
+use idevice::{afc::{AfcClient, FileInfo, errors::AfcError, opcode::{AfcFopenMode, LinkType}}, IdeviceError};
+use serde::{Deserialize, Serialize};
+use tokio::{fs, io::{AsyncReadExt, AsyncWriteExt}};
+use uuid::Uuid;
+
+use super::{db, sideload, state::AppState};
+
+const ROOT: &str = "/Documents";
+const ACCESS_TIMEOUT: Duration = Duration::from_secs(35);
+const TRANSFER_TIMEOUT: Duration = Duration::from_secs(600);
+
+#[derive(Serialize, Deserialize)]
+struct Snapshot {
+    id: Uuid,
+    created: i64,
+    files: usize,
+}
+
+fn safe_name(name: &str) -> bool {
+    !name.is_empty() && name != "." && name != ".."
+        && !name.contains(['/', '\\']) && !name.chars().any(char::is_control)
+}
+
+fn storage_path(database: &Path, udid: &str, bundle: &str) -> anyhow::Result<PathBuf> {
+    for id in [udid, bundle] {
+        ensure!(safe_name(id) && id.bytes().all(|byte| byte.is_ascii_alphanumeric() || b".-".contains(&byte)),
+            "The device or app identifier cannot be used to store documents.");
+    }
+    Ok(database.parent().context("SideRelay storage is unavailable.")?
+        .join("sauvegardes-documents").join(udid).join(bundle))
+}
+
+async fn snapshots(root: &Path) -> anyhow::Result<Vec<Snapshot>> {
+    let mut listing = match fs::read_dir(root).await {
+        Ok(listing) => listing,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(Vec::new()),
+        Err(error) => return Err(error.into()),
+    };
+    let mut values = Vec::new();
+    while let Some(entry) = listing.next_entry().await? {
+        let Some(id) = entry.file_name().to_str().and_then(|name| Uuid::parse_str(name).ok()) else { continue };
+        if !entry.file_type().await?.is_dir() { continue }
+        let data = fs::read(entry.path().join("snapshot.json")).await?;
+        let value: Snapshot = serde_json::from_slice(&data)?;
+        ensure!(value.id == id, "A saved documents backup has invalid metadata.");
+        values.push(value);
+    }
+    values.sort_by_key(|snapshot| std::cmp::Reverse((snapshot.created, snapshot.id)));
+    Ok(values)
+}
+
+pub async fn perform(state: &AppState, app_id: &str, action: &str, snapshot: &str) -> anyhow::Result<serde_json::Value> {
+    ensure!(matches!(action, "status" | "probe" | "backup" | "restore"), "Unknown documents action.");
+    let _signing = if action != "status" { Some(state.signing.lock().await) } else { None };
+    let app = db::get_app(&state.db, app_id).await?.context("App not found.")?;
+    ensure!(app.installed_at.is_some(), "Install the app before accessing its documents.");
+    let device = db::get_device(&state.db, &app.device_id).await?.context("Device not found.")?;
+    let root = storage_path(Path::new(&state.config.storage.database_path), &device.udid, &app.bundle_id)?;
+    if action == "status" {
+        return Ok(serde_json::json!({ "snapshots": snapshots(&root).await? }));
+    }
+    let chosen = if action == "restore" {
+        let id = Uuid::parse_str(snapshot).context("Select a documents backup first.")?;
+        Some(snapshots(&root).await?.into_iter().find(|saved| saved.id == id).context("Documents backup not found.")?)
+    } else { None };
+    let mut afc = tokio::time::timeout(ACCESS_TIMEOUT, sideload::shared_documents(&device, &state.crypto, &app.bundle_id))
+        .await.context("Apple File Sharing did not respond. Check the device connection and unlock it.")??;
+    if action == "probe" {
+        return Ok(serde_json::json!({ "shared": true }));
+    }
+    if let Some(saved) = chosen {
+        let source = root.join(saved.id.to_string()).join("files");
+        let mut progress = (0, 0);
+        let result = tokio::time::timeout(TRANSFER_TIMEOUT, restore(&mut afc, &source, &mut progress)).await;
+        if let Err(error) = result.context("The device stopped responding during restoration.").and_then(|result| result) {
+            anyhow::bail!("Restoration stopped after {} file(s) restored and {} skipped: {error}", progress.0, progress.1);
+        }
+        return Ok(serde_json::json!({ "restored": progress.0, "skipped": progress.1 }));
+    }
+
+    let id = Uuid::new_v4();
+    let stage = root.join(format!(".{id}"));
+    let parent = root.ancestors().nth(2).context("SideRelay storage is unavailable.")?;
+    let mut builder = fs::DirBuilder::new();
+    builder.recursive(true).mode(0o700);
+    builder.create(parent).await?;
+    builder.create(stage.join("files")).await?;
+    let result = async {
+        let files = tokio::time::timeout(TRANSFER_TIMEOUT, backup(&mut afc, &stage.join("files"))).await
+            .context("The device stopped responding during backup.")??;
+        let snapshot = Snapshot { id, created: chrono::Utc::now().timestamp(), files };
+        let mut manifest = fs::File::create(stage.join("snapshot.json")).await?;
+        manifest.write_all(&serde_json::to_vec(&snapshot)?).await?;
+        manifest.sync_all().await?;
+        fs::rename(&stage, root.join(id.to_string())).await?;
+        Ok::<_, anyhow::Error>(serde_json::json!({ "snapshot": snapshot }))
+    }.await;
+    if result.is_err() { let _ = fs::remove_dir_all(&stage).await; }
+    result
+}
+
+async fn backup(afc: &mut AfcClient, destination: &Path) -> anyhow::Result<usize> {
+    let mut pending = vec![(ROOT.to_owned(), destination.to_path_buf())];
+    let mut files = 0;
+    while let Some((remote, local)) = pending.pop() {
+        for name in afc.list_dir(&remote).await? {
+            if matches!(name.as_str(), "." | "..") { continue }
+            ensure!(safe_name(&name), "The Documents folder contains a name that cannot be backed up.");
+            let remote = format!("{remote}/{name}");
+            let local = local.join(name);
+            let info = afc.get_file_info(&remote).await?;
+            match info.st_ifmt.as_str() {
+                "S_IFDIR" => {
+                    fs::create_dir(&local).await?;
+                    pending.push((remote, local));
+                }
+                "S_IFREG" => {
+                    let mut input = afc.open(&remote, AfcFopenMode::RdOnly).await?;
+                    let mut output = fs::OpenOptions::new().create_new(true).write(true).open(&local).await?;
+                    let copied = tokio::io::copy(&mut (&mut input).take(info.size as u64), &mut output).await?;
+                    input.close().await?;
+                    ensure!(copied == info.size as u64, "A document changed during backup. Close the app and try again.");
+                    output.sync_all().await?;
+                    let after = afc.get_file_info(&remote).await?;
+                    ensure!(info.size == after.size && info.modified == after.modified, "A document changed during backup. Close the app and try again.");
+                    files += 1;
+                }
+                _ => anyhow::bail!("The Documents folder contains a link or unsupported file. No backup was saved."),
+            }
+        }
+    }
+    Ok(files)
+}
+
+async fn remote_entry(afc: &mut AfcClient, path: &str) -> anyhow::Result<Option<FileInfo>> {
+    match afc.get_file_info(path).await {
+        Ok(info) => Ok(Some(info)),
+        Err(IdeviceError::Afc(AfcError::ObjectNotFound)) => Ok(None),
+        Err(error) => Err(error.into()),
+    }
+}
+
+async fn restore(afc: &mut AfcClient, source: &Path, progress: &mut (usize, usize)) -> anyhow::Result<()> {
+    ensure!(fs::symlink_metadata(source).await?.is_dir(), "This backup has no documents folder.");
+    let mut pending = vec![(ROOT.to_owned(), source.to_path_buf())];
+    while let Some((remote, local)) = pending.pop() {
+        let mut entries = fs::read_dir(&local).await?;
+        while let Some(entry) = entries.next_entry().await? {
+            let name = entry.file_name().into_string().ok().filter(|name| safe_name(name))
+                .context("The backup contains an invalid document name.")?;
+            let target = format!("{remote}/{name}");
+            let kind = entry.file_type().await?;
+            let existing = remote_entry(afc, &target).await?;
+            if kind.is_dir() {
+                if let Some(info) = existing {
+                    if info.st_ifmt != "S_IFDIR" { progress.1 += 1; continue }
+                } else {
+                    afc.mk_dir(&target).await?;
+                }
+                pending.push((target, entry.path()));
+                continue;
+            }
+            ensure!(kind.is_file(), "The backup contains an unsupported file.");
+            if existing.is_some() { progress.1 += 1; continue }
+            let stage = format!("{remote}/.siderelay-{}", Uuid::new_v4());
+            let result = async {
+                let mut input = fs::File::open(entry.path()).await?;
+                let mut output = afc.open(&stage, AfcFopenMode::WrOnly).await?;
+                tokio::io::copy(&mut input, &mut output).await?;
+                output.flush().await?;
+                output.close().await?;
+                // Creating a hard link publishes the completed file without replacing
+                // an existing file, including one created during the transfer.
+                afc.link(&stage, &target, LinkType::Hardlink).await?;
+                Ok::<_, anyhow::Error>(())
+            }.await;
+            let _ = afc.remove(&stage).await;
+            match result {
+                Ok(()) => progress.0 += 1,
+                Err(_) if remote_entry(afc, &target).await?.is_some() => progress.1 += 1,
+                Err(error) => return Err(error),
+            }
+        }
+    }
+    Ok(())
+}
