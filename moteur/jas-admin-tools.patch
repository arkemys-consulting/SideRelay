+#[cfg(test)]
+mod tests {
+    use super::*;
+    use idevice::{Idevice, afc::{MAGIC, opcode::AfcOpcode, packet::{AfcPacket, AfcPacketHeader}}};
+    use std::collections::HashMap;
+
+    async fn fake_afc(socket: tokio::io::DuplexStream) -> HashMap<String, Vec<u8>> {
+        let mut peer = Idevice::new(Box::new(socket), "");
+        let mut files = HashMap::from([
+            ("/Documents/report.txt".to_owned(), b"saved draft".to_vec()),
+            ("/Documents/keep.txt".to_owned(), b"before backup".to_vec()),
+        ]);
+        let mut current = String::new();
+        while let Ok(request) = AfcPacket::read(&mut peer).await {
+            let body = &request.header_payload;
+            let path = |bytes: &[u8]| String::from_utf8_lossy(bytes).trim_end_matches('\0').to_owned();
+            let (operation, header, payload) = match request.header.operation {
+                AfcOpcode::ReadDir => {
+                    assert_eq!(path(body), ROOT);
+                    (AfcOpcode::Data, vec![], b".\0..\0report.txt\0keep.txt\0".to_vec())
+                }
+                AfcOpcode::GetFileInfo => match files.get(&path(body)) {
+                    Some(bytes) => (AfcOpcode::Data, vec![], [
+                        "st_size", &bytes.len().to_string(), "st_blocks", "1",
+                        "st_birthtime", "0", "st_mtime", "0", "st_nlink", "1", "st_ifmt", "S_IFREG", "",
+                    ].join("\0").into_bytes()),
+                    None => (AfcOpcode::Status, 8u64.to_le_bytes().to_vec(), vec![]),
+                },
+                AfcOpcode::FileOpen => {
+                    current = path(&body[8..]);
+                    if body[0] == AfcFopenMode::WrOnly as u8 {
+                        files.insert(current.clone(), Vec::new());
+                    }
+                    (AfcOpcode::FileOpenRes, 1u64.to_le_bytes().to_vec(), vec![])
+                }
+                AfcOpcode::Read => (AfcOpcode::Data, vec![], files[&current].clone()),
+                AfcOpcode::Write => {
+                    files.get_mut(&current).unwrap().extend(request.payload);
+                    (AfcOpcode::Status, vec![0; 8], vec![])
+                }
+                AfcOpcode::MakeLink => {
+                    let mut paths = body[8..].split(|&byte| byte == 0);
+                    let stage = path(paths.next().unwrap());
+                    let target = path(paths.next().unwrap());
+                    assert!(stage.starts_with("/Documents/.siderelay-"));
+                    assert_eq!(target, "/Documents/report.txt");
+                    assert_eq!(body[0], LinkType::Hardlink as u8);
+                    assert!(!files.contains_key(&target));
+                    files.insert(target, files[&stage].clone());
+                    (AfcOpcode::Status, vec![0; 8], vec![])
+                }
+                AfcOpcode::RemovePath => {
+                    files.remove(&path(body));
+                    (AfcOpcode::Status, vec![0; 8], vec![])
+                }
+                AfcOpcode::FileClose => (AfcOpcode::Status, vec![0; 8], vec![]),
+                _ => panic!("Unexpected AFC operation: {:?}", request.header.operation),
+            };
+            let response = AfcPacket {
+                header: AfcPacketHeader {
+                    magic: MAGIC, entire_len: 40 + (header.len() + payload.len()) as u64,
+                    header_payload_len: 40 + header.len() as u64,
+                    packet_num: request.header.packet_num, operation,
+                },
+                header_payload: header,
+                payload,
+            };
+            if peer.send_raw(&response.serialize()).await.is_err() { break }
+            if request.header.operation == AfcOpcode::GetFileInfo && current == "/Documents/keep.txt"
+                && path(body) == current && files.contains_key("/Documents/report.txt")
+            {
+                files.remove("/Documents/report.txt");
+                files.insert(current.clone(), b"changed on device".to_vec());
+                current.clear();
+            }
+        }
+        files
+    }
+
+    #[tokio::test]
+    async fn shared_backup_and_restore_keep_existing_file() {
+        let folder = std::env::temp_dir().join(format!("siderelay-documents-test-{}", Uuid::new_v4()));
+        fs::create_dir(&folder).await.unwrap();
+        let (device, host) = tokio::io::duplex(64 * 1024);
+        let device = tokio::spawn(fake_afc(device));
+        let mut afc = AfcClient::new(Idevice::new(Box::new(host), ""));
+        let result = async {
+            assert_eq!(backup(&mut afc, &folder).await?, 2);
+            assert_eq!(fs::read(folder.join("report.txt")).await?, b"saved draft");
+            assert_eq!(fs::read(folder.join("keep.txt")).await?, b"before backup");
+            let mut progress = (0, 0);
+            restore(&mut afc, &folder, &mut progress).await?;
+            assert_eq!(progress, (1, 1));
+            Ok::<_, anyhow::Error>(())
+        }.await;
+        drop(afc);
+        fs::remove_dir_all(&folder).await.unwrap();
+        result.unwrap();
+        let files = device.await.unwrap();
+        assert_eq!(files["/Documents/report.txt"], b"saved draft");
+        assert_eq!(files["/Documents/keep.txt"], b"changed on device");
+        assert_eq!(files.len(), 2);
+    }
+}
