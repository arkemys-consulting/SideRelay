+pub async fn shared_documents(device: &DeviceRow, crypto: &Crypto, bundle: &str) -> anyhow::Result<AfcClient> {
+    let mut connection = DeviceConnection::open(device, crypto).await?;
+    let client = match &mut connection {
+        DeviceConnection::Usb(provider) => HouseArrestClient::connect(provider).await,
+        DeviceConnection::Network(handle, handshake) => HouseArrestClient::connect_rsd(handle, handshake).await,
+    }.map_err(|error| anyhow::anyhow!("Could not open Apple File Sharing. Unlock the device and try again: {error}"))?;
+    let mut afc = client.vend_documents(bundle.to_owned()).await
+        .map_err(|error| anyhow::anyhow!("iOS did not grant access to shared Documents. Check that the app enables Apple File Sharing and the iPhone is unlocked: {error}"))?;
+    afc.list_dir("/Documents").await
+        .map_err(|_| anyhow::anyhow!("The app’s shared Documents folder is unavailable. The app must enable Apple File Sharing."))?;
+    Ok(afc)
+}
