+#[cfg(feature = "ssr")]
+#[server(endpoint = "/manage_app_ids11318273670462819093")]
+pub async fn manage_app_ids(account_id: String, operation: String, identifiers_json: Option<String>) -> Result<serde_json::Value, ServerFnError> {
+    let headers: axum::http::HeaderMap = leptos_axum::extract().await?;
+    if headers.get("X-SideRelay-App-IDs").and_then(|value| value.to_str().ok()) != Some("manage")
+        || !matches!(operation.as_str(), "inspect" | "remove" | "enable" | "disable")
+    {
+        return Err(ServerFnError::new("Use SideRelay’s Apple Accounts to manage App IDs."));
+    }
+    let identifiers: Vec<String> = serde_json::from_str(identifiers_json.as_deref().unwrap_or("[]"))
+        .map_err(|_| ServerFnError::new("Invalid App ID selection."))?;
+    let state = leptos::prelude::use_context::<crate::server::state::AppState>()
+        .ok_or_else(|| ServerFnError::new("No state"))?;
+    if operation == "disable" {
+        let _operation = state.signing.lock().await;
+        sqlx::query("DELETE FROM app_id_cleanup WHERE account_id = ?")
+            .bind(&account_id).execute(&state.db).await
+            .map_err(|error| ServerFnError::new(error.to_string()))?;
+        return Ok(serde_json::json!({ "automatic": false }));
+    }
+    let report = crate::server::app_ids::manage(&state, &account_id, &operation, &identifiers).await
+        .map_err(|error| ServerFnError::new(error.to_string()))?;
+    serde_json::to_value(report).map_err(|error| ServerFnError::new(error.to_string()))
+}
