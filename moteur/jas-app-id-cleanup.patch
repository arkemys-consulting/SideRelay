+// A partial InstallationProxy browse cannot establish that an App ID is unused.
+pub async fn verified_installed_bundle_ids(
+    device: &DeviceRow,
+    crypto: &Crypto,
+) -> anyhow::Result<std::collections::HashSet<String>> {
+    if device.is_tvos() {
+        return super::tvos::installed_apps(device).await;
+    }
+    let mut connection = DeviceConnection::open(device, crypto).await?;
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+
+    let mut socket = connection.installation_proxy().await?.idevice.get_socket()
+        .ok_or_else(|| anyhow::anyhow!("InstallationProxy closed the connection."))?;
+    let options: plist::Dictionary = [
+        ("ApplicationType".to_owned(), "Any".into()),
+        ("ReturnAttributes".to_owned(), plist::Value::Array(vec!["CFBundleIdentifier".into()])),
+    ].into_iter().collect();
+    let request: plist::Dictionary = [
+        ("Command".to_owned(), "Browse".into()),
+        ("ClientOptions".to_owned(), plist::Value::Dictionary(options)),
+    ].into_iter().collect();
+    let mut payload = Vec::new();
+    plist::to_writer_xml(&mut payload, &request)?;
+    socket.write_u32(payload.len() as u32).await?;
+    socket.write_all(&payload).await?;
+    socket.flush().await?;
+
+    let mut identifiers = std::collections::HashSet::new();
+    loop {
+        let size = socket.read_u32().await? as usize;
+        anyhow::ensure!(size > 0 && size <= 4 * 1024 * 1024, "Invalid app inventory frame.");
+        let mut payload = vec![0; size];
+        socket.read_exact(&mut payload).await?;
+        let mut reply: plist::Dictionary = plist::from_bytes(&payload)?;
+        anyhow::ensure!(!reply.contains_key("Error"), "Could not verify installed apps.");
+        let complete = reply.get("Status").and_then(plist::Value::as_string) == Some("Complete");
+        match reply.remove("CurrentList") {
+            Some(plist::Value::Array(entries)) => for entry in entries {
+                let bundle = entry.as_dictionary().and_then(|entry| entry.get("CFBundleIdentifier"))
+                    .and_then(plist::Value::as_string)
+                    .ok_or_else(|| anyhow::anyhow!("An installed app was returned without its Bundle ID."))?;
+                identifiers.insert(bundle.to_owned());
+            },
+            None if complete => {},
+            _ => anyhow::bail!("The device returned an incomplete app inventory."),
+        }
+        if complete { return Ok(identifiers); }
+    }
+}
