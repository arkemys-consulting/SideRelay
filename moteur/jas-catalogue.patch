+ALTER TABLE apps ADD COLUMN profile_details TEXT;
+ALTER TABLE jobs ADD COLUMN install_ipa_path TEXT;
+ALTER TABLE jobs ADD COLUMN expected_bundle_id TEXT;
+
+CREATE TABLE ipa_packages (
+    id TEXT PRIMARY KEY,
+    path TEXT NOT NULL UNIQUE,
+    bundle_id TEXT NOT NULL,
+    display_name TEXT NOT NULL,
+    version TEXT,
+    metadata TEXT,
+    source_id TEXT,
+    imported_at INTEGER NOT NULL
+);
+
+CREATE TABLE ipa_installations (
+    app_id TEXT NOT NULL REFERENCES apps(id) ON DELETE CASCADE,
+    package_id TEXT NOT NULL REFERENCES ipa_packages(id),
+    installed_at INTEGER NOT NULL,
+    PRIMARY KEY (app_id, package_id)
+);
+
+CREATE TABLE ipa_sources (
+    id TEXT PRIMARY KEY,
+    url TEXT NOT NULL UNIQUE,
+    name TEXT NOT NULL,
+    catalogue TEXT NOT NULL,
+    checked_at INTEGER NOT NULL
+);
+
+INSERT OR IGNORE INTO ipa_packages (id, path, bundle_id, display_name, version, imported_at)
+SELECT lower(hex(randomblob(16))), ipa_path, bundle_id, display_name, version,
+       coalesce(installed_at, unixepoch())
+FROM apps WHERE ipa_path IS NOT NULL;
+
+INSERT INTO ipa_installations (app_id, package_id, installed_at)
+SELECT apps.id, ipa_packages.id, apps.installed_at
+FROM apps JOIN ipa_packages ON ipa_packages.path = apps.ipa_path
+WHERE apps.installed_at IS NOT NULL;
+
+UPDATE apps SET profile_details = json_array(json_object('bundleId', bundle_id, 'expiresAt', profile_expires_at))
+WHERE installed_at IS NOT NULL AND profile_expires_at IS NOT NULL AND signed_extension_ids = '[]';
