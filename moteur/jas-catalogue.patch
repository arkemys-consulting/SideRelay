+#[derive(Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct CertificateStatus {
+    pub serial: String,
+    pub name: String,
+    pub expires_at: Option<i64>,
+    pub state: String,
+    pub used: bool,
+    pub apps: Vec<Impact>,
+}
+
+pub async fn signing_status(state: &AppState, account_id: &str) -> anyhow::Result<Vec<CertificateStatus>> {
+    let _signing = state.signing.lock().await;
+    let mut apple = AppleContext::open(state, account_id).await?;
+    let entries = apple.certificates().await?;
+    let used = CertificateIdentity::reuse(&apple.team, &apple.storage, &apple.apple_id, &entries)
+        .map_err(sideload::signing_error)?.map(|identity| identity.get_serial_number());
+    let now = chrono::Utc::now().timestamp();
+    let mut status = Vec::new();
+    for entry in entries {
+        let Some(serial) = entry.serial_number.as_deref() else { continue };
+        let serial = serial.trim_start_matches('0').to_ascii_uppercase();
+        let expires_at = entry.expiration_date.map(|date|
+            chrono::DateTime::<chrono::Utc>::from(std::time::SystemTime::from(date)).timestamp());
+        let condition = if entry.status.as_deref().is_some_and(|s| s.eq_ignore_ascii_case("revoked")) {
+            "Revoked"
+        } else if expires_at.is_some_and(|expiry| expiry <= now) {
+            "Expired"
+        } else if entry.status.as_deref().is_some_and(|s| !s.eq_ignore_ascii_case("active") && !s.eq_ignore_ascii_case("issued")) {
+            "Status unknown"
+        } else {
+            "Listed by Apple"
+        };
+        let apps = tracked_apps(state, &apple.team.team_id, &serial).await?;
+        status.push(CertificateStatus {
+            used: used.as_deref() == Some(&serial),
+            serial,
+            name: entry.machine_name.filter(|value| !value.trim().is_empty())
+                .or(entry.name).unwrap_or_else(|| "Apple Development".into()),
+            expires_at,
+            state: condition.into(),
+            apps,
+        });
+    }
+    let tracked: Vec<String> = sqlx::query_scalar(
+        "SELECT DISTINCT signing_serial FROM apps WHERE signing_team = ? AND installed_at IS NOT NULL
+         AND signing_serial IS NOT NULL",
+    ).bind(&apple.team.team_id).fetch_all(&state.db).await?;
+    for serial in tracked {
+        if status.iter().any(|entry| entry.serial == serial) { continue; }
+        status.push(CertificateStatus {
+            apps: tracked_apps(state, &apple.team.team_id, &serial).await?,
+            serial, name: "Apple Development".into(), expires_at: None,
+            state: "No longer listed by Apple".into(), used: false,
+        });
+    }
+    status.sort_by_key(|entry| (!entry.used, entry.name.to_lowercase(), entry.serial.clone()));
+    Ok(status)
+}
+
+async fn tracked_apps(state: &AppState, team: &str, serial: &str) -> anyhow::Result<Vec<Impact>> {
+    let rows = sqlx::query_as::<_, (String, String, String, Option<String>)>(
+        "SELECT a.id, a.display_name, d.name, a.ipa_path FROM apps a JOIN devices d ON a.device_id = d.id
+         WHERE a.signing_team = ? AND a.signing_serial = ? AND a.installed_at IS NOT NULL
+         ORDER BY a.display_name, d.name",
+    ).bind(team).bind(serial).fetch_all(&state.db).await?;
+    Ok(rows.into_iter().map(|(id, name, device, archive)| Impact {
+        id, name, device, certain: true,
+        can_repair: archive.as_deref().is_some_and(|path| std::path::Path::new(path).is_file()),
+    }).collect())
+}
