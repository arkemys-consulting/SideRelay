+use super::{sideload::{self, IpaInfo}, state::{AppState, JobKind, JobRequest}};
+
+const MAX_IPA: usize = 512 * 1024 * 1024;
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Package {
+    id: String,
+    source_id: Option<String>,
+    #[serde(flatten)]
+    info: IpaInfo,
+}
+
+fn inspect_path(path: &Path) -> anyhow::Result<IpaInfo> {
+    sideload::inspect_ipa(std::fs::File::open(path)?)
+}
+
+async fn inspect_file(path: String) -> anyhow::Result<IpaInfo> {
+    tokio::task::spawn_blocking(move || inspect_path(Path::new(&path))).await?
+}
+
+async fn write_archive(destination: &Path, bytes: &[u8]) -> anyhow::Result<()> {
+    let parent = destination.parent().context("IPA directory is missing.")?;
+    tokio::fs::create_dir_all(parent).await?;
+    let scratch = parent.join(format!(".import-{}", Uuid::new_v4()));
+    let result = async {
+        let mut file = tokio::fs::OpenOptions::new()
+            .mode(0o600).create_new(true).write(true).open(&scratch).await?;
+        file.write_all(bytes).await?;
+        file.sync_all().await?;
+        drop(file);
+        tokio::fs::rename(&scratch, destination).await?;
+        Ok::<_, std::io::Error>(())
+    }.await;
+    if result.is_err() {
+        let _ = tokio::fs::remove_file(&scratch).await;
+    }
+    Ok(result?)
+}
+
+pub async fn archive(
+    state: &AppState,
+    bytes: &[u8],
+    info: IpaInfo,
+    source_id: Option<&str>,
+) -> anyhow::Result<(Package, String)> {
+    let id = hex::encode(Sha256::digest(bytes));
+    let path = PathBuf::from(&state.config.storage.ipa_dir).join("library").join(format!("{id}.ipa"));
+    if !path.is_file() {
+        write_archive(&path, bytes).await?;
+    }
+    let path = path.to_str().context("Invalid IPA storage path.")?.to_owned();
+    let source = sqlx::query_scalar::<_, Option<String>>(
+        "INSERT INTO ipa_packages (id, path, bundle_id, display_name, version, metadata, source_id, imported_at)
+         VALUES (?, ?, ?, ?, ?, ?, ?, unixepoch())
+         ON CONFLICT(id) DO UPDATE SET source_id = coalesce(ipa_packages.source_id, excluded.source_id)
+         RETURNING source_id",
+    )
+    .bind(&id).bind(&path).bind(&info.bundle_id).bind(&info.display_name).bind(&info.version)
+    .bind(serde_json::to_string(&info)?).bind(source_id).fetch_one(&state.db).await?;
+    Ok((Package { id, source_id: source, info }, path))
+}
+
+pub async fn temporary_archive(state: &AppState, bytes: &[u8]) -> anyhow::Result<String> {
+    let path = PathBuf::from(&state.config.storage.ipa_dir)
+        .join("temporary").join(format!("{}.ipa", Uuid::new_v4()));
+    write_archive(&path, bytes).await?;
+    Ok(path.to_str().context("Invalid temporary IPA path.")?.to_owned())
+}
+
+pub async fn load_package(state: &AppState, id: &str) -> anyhow::Result<(String, IpaInfo)> {
+    let path: String = sqlx::query_scalar("SELECT path FROM ipa_packages WHERE id = ?")
+        .bind(id).fetch_optional(&state.db).await?.context("IPA no longer in the library.")?;
+    let info = inspect_file(path.clone()).await.context("Could not read the saved IPA.")?;
+    Ok((path, info))
+}
+
+pub async fn package_on_disk(path: &str) -> anyhow::Result<IpaInfo> {
+    inspect_file(path.to_owned()).await
+}
+
+pub async fn queue_install(
+    state: &AppState,
+    device_id: &str,
+    account_id: &str,
+    path: &str,
+    temporary: bool,
+    info: &IpaInfo,
+    target_app_id: Option<&str>,
+) -> anyhow::Result<String> {
+    let account_team: Option<String> = sqlx::query_scalar(
+        "SELECT team_id FROM apple_accounts WHERE id = ?",
+    ).bind(account_id).fetch_optional(&state.db).await?.context("Select an Apple Account.")?;
+    let device_exists: bool = sqlx::query_scalar("SELECT EXISTS(SELECT 1 FROM devices WHERE id = ?)")
+        .bind(device_id).fetch_one(&state.db).await?;
+    ensure!(device_exists, "Select a paired iPhone or iPad.");
+
+    let mut tx = state.db.begin_with("BEGIN IMMEDIATE").await?;
+    let exact_target = match target_app_id.filter(|id| !id.is_empty()) {
+        Some(id) => {
+            let (id, installed_id, account, original_id): (String, String, Option<String>, Option<String>) = sqlx::query_as(
+                "SELECT a.id, a.bundle_id, a.account_id, p.bundle_id
+                 FROM apps a LEFT JOIN ipa_packages p ON p.path = a.ipa_path
+                 WHERE a.id = ? AND a.device_id = ? AND a.installed_at IS NOT NULL",
+            ).bind(id).bind(device_id).fetch_optional(&mut *tx).await?
+                .context("The selected app is no longer installed on this device.")?;
+            ensure!(account.as_deref() == Some(account_id), "Use the Apple Account linked to this app.");
+            let expected = account_team.as_ref().map(|team| format!("{}.{team}", info.bundle_id));
+            ensure!(installed_id == info.bundle_id || original_id.as_deref() == Some(&info.bundle_id)
+                || expected.as_deref() == Some(&installed_id), "The Bundle ID does not match the installed app.");
+            Some((id, installed_id))
+        }
+        None => {
+            let signed = account_team.as_ref().map(|team| format!("{}.{team}", info.bundle_id));
+            let matches: Vec<(String, String)> = sqlx::query_as(
+                "SELECT DISTINCT a.id, a.bundle_id FROM apps a
+                 LEFT JOIN ipa_packages p ON p.path = a.ipa_path
+                 WHERE a.device_id = ? AND a.account_id = ? AND a.installed_at IS NOT NULL
+                 AND (a.bundle_id = ? OR a.bundle_id = ? OR p.bundle_id = ?)",
+            ).bind(device_id).bind(account_id).bind(&info.bundle_id).bind(signed)
+                .bind(&info.bundle_id).fetch_all(&mut *tx).await?;
+            ensure!(matches.len() <= 1, "Select the app to update from its Apps card.");
+            matches.into_iter().next()
+        }
+    };
+
+    let (app_id, expected_bundle) = match exact_target {
+        Some((id, bundle)) => (id, Some(bundle)),
+        None => {
+            let new_id = Uuid::new_v4().to_string();
+            let row: (String, Option<i64>) = sqlx::query_as(
+                "INSERT INTO apps (id, device_id, bundle_id, display_name, version, ipa_path, account_id)
+                 VALUES (?, ?, ?, ?, ?, ?, ?)
+                 ON CONFLICT(device_id, bundle_id) DO UPDATE SET id = apps.id
+                 RETURNING id, installed_at",
+            ).bind(&new_id).bind(device_id).bind(&info.bundle_id).bind(&info.display_name)
+                .bind(&info.version).bind((!temporary).then_some(path)).bind(account_id)
+                .fetch_one(&mut *tx).await?;
+            (row.0, row.1.map(|_| info.bundle_id.clone()))
+        }
+    };
+    let job_id = Uuid::new_v4().to_string();
+    let inserted = sqlx::query(
+        "INSERT INTO jobs (id, app_id, kind, status, install_ipa_path, expected_bundle_id)
+         SELECT ?, ?, 'install', 'queued', ?, ?
+         WHERE NOT EXISTS (SELECT 1 FROM jobs WHERE app_id = ? AND status IN ('queued', 'running', 'pending'))",
+    ).bind(&job_id).bind(&app_id).bind((!temporary).then_some(path)).bind(&expected_bundle)
+        .bind(&app_id).execute(&mut *tx).await?;
+    ensure!(inserted.rows_affected() == 1, "Another operation for this app is in progress.");
+    tx.commit().await?;
+
+    let request = JobRequest {
+        job_id: job_id.clone(), app_id, device_id: device_id.to_owned(), account_id: account_id.to_owned(),
+        kind: JobKind::Install { ipa_path: path.to_owned(), temporary, expected_bundle },
+    };
+    if state.job_tx.send(request).await.is_err() {
+        super::db::update_job_status(&state.db, &job_id, "failed", Some("The installation queue is unavailable.")).await?;
+        anyhow::bail!("The installation queue is unavailable.");
+    }
+    Ok(job_id)
+}
+
+pub fn routes(state: AppState) -> axum::Router {
+    axum::Router::new()
+        .route("/api/siderelay/ipa/{action}", axum::routing::post(upload))
+        .layer(axum::extract::DefaultBodyLimit::max(MAX_IPA))
+        .with_state(state)
+}
+
+async fn upload(
+    State(state): State<AppState>,
+    ConnectInfo(peer): ConnectInfo<SocketAddr>,
+    RoutePath(action): RoutePath<String>,
+    headers: HeaderMap,
+    bytes: Bytes,
+) -> Response {
+    let header_value = |name: &str| headers.get(name).and_then(|v| v.to_str().ok());
+    let Some(host) = header_value("host").filter(|host| host.starts_with("127.0.0.1:")) else {
+        return StatusCode::FORBIDDEN.into_response();
+    };
+    let origin = format!("http://{host}");
+    if !peer.ip().is_loopback()
+        || header_value("origin").is_some_and(|value| value != origin)
+        || header_value("x-siderelay-action") != Some("catalogue")
+        || header_value("content-type") != Some("application/octet-stream")
+    {
+        return StatusCode::FORBIDDEN.into_response();
+    }
+    let result = async {
+        let (info, bytes) = tokio::task::spawn_blocking(move || {
+            let info = sideload::read_ipa_info(&bytes)?;
+            Ok::<_, anyhow::Error>((info, bytes))
+        }).await??;
+        if action == "inspect" {
+            return Ok(Json(serde_json::to_value(info)?).into_response());
+        }
+        ensure!(action == "import", "Unknown IPA action.");
+        if let Some(expected) = header_value("x-siderelay-bundle") {
+            ensure!(info.bundle_id == expected, "The downloaded IPA has a different Bundle ID than the source lists.");
+        }
+        if let Some(expected) = header_value("x-siderelay-version") {
+            ensure!(info.version.as_deref() == Some(expected), "The downloaded IPA has a different version than the source lists.");
+        }
+        if let Some(expected) = header_value("x-siderelay-build") {
+            ensure!(info.build.as_deref() == Some(expected), "The downloaded IPA has a different build than the source lists.");
+        }
+        let source = header_value("x-siderelay-source").filter(|id| Uuid::parse_str(id).is_ok());
+        let (package, _) = archive(&state, &bytes, info, source).await?;
+        Ok::<Response, anyhow::Error>(Json(serde_json::to_value(package)?).into_response())
+    }.await;
+    match result {
+        Ok(response) => response,
+        Err(error) => (StatusCode::UNPROCESSABLE_ENTITY,
+                       [(header::CACHE_CONTROL, "no-store")], error.to_string()).into_response(),
+    }
+}
