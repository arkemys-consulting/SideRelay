diff --git a/src/server/certificates.rs b/src/server/certificates.rs
new file mode 100644
index 0000000..b5fb4b7
--- /dev/null
+++ b/src/server/certificates.rs
@@ -0,0 +1,321 @@
+use std::time::{Duration, Instant};
+
+use anyhow::{anyhow, ensure, Context};
+use isideload::{
+    dev::{
+        certificates::{CertificatesApi, DevelopmentCertificate},
+        developer_session::DeveloperSession,
+        teams::{DeveloperTeam, TeamsApi},
+    },
+    sideload::{
+        builder::MaxCertsBehavior,
+        cert_identity::CertificateIdentity,
+    },
+    util::callbacks::MaxCertsCallbackBox,
+};
+use serde::{Deserialize, Serialize};
+use uuid::Uuid;
+
+use crate::server::{
+    db::{self, storage::DbStorage},
+    sideload::{self, CERTIFICATE_LIMIT},
+    state::{AppState, JobKind, JobRequest},
+};
+
+const PLAN_DURATION: Duration = Duration::from_secs(300);
+
+#[derive(Clone, Deserialize, Serialize, PartialEq, Eq)]
+pub struct Impact {
+    id: String,
+    name: String,
+    device: String,
+    certain: bool,
+    can_repair: bool,
+}
+
+#[derive(Clone, Deserialize, Serialize, PartialEq, Eq)]
+pub struct Candidate {
+    serial: String,
+    label: String,
+    apps: Vec<Impact>,
+}
+
+#[derive(Deserialize, Serialize)]
+pub struct Review {
+    token: String,
+    certificates: Vec<Candidate>,
+}
+
+pub struct Plan {
+    expires: Instant,
+    account_id: String,
+    job_id: String,
+    app_id: String,
+    team_id: String,
+    certificates: Vec<Candidate>,
+}
+
+struct AppleContext {
+    session: DeveloperSession,
+    storage: DbStorage,
+    team: DeveloperTeam,
+    apple_id: String,
+}
+
+impl AppleContext {
+    async fn open(state: &AppState, account_id: &str) -> anyhow::Result<Self> {
+        let (apple_id, session_blob, team_id): (String, Vec<u8>, Option<String>) = sqlx::query_as(
+            "SELECT apple_id, session_blob, team_id FROM apple_accounts WHERE id = ?",
+        ).bind(account_id).fetch_optional(&state.db).await?.context("Apple Account not found.")?;
+        let anisette_url = state.anisette_url.read().await.clone();
+        let mut session = sideload::get_dev_session(
+            &state.db, &apple_id, &session_blob, &state.crypto, &anisette_url,
+        ).await?;
+        let team = session.list_teams().await.map_err(sideload::signing_error)?
+            .into_iter().next().context("No developer team found.")?;
+        ensure!(team_id.as_ref().is_none_or(|id| id == &team.team_id),
+            "The Apple developer team changed. Sign in again before reviewing certificates.");
+        let storage = DbStorage::load(state.db.clone(), &sideload::account_storage_prefix(&apple_id))
+            .await?.protect_signing_key(&state.crypto);
+        Ok(Self { session, storage, team, apple_id })
+    }
+
+    async fn certificates(&mut self) -> anyhow::Result<Vec<DevelopmentCertificate>> {
+        self.session.list_ios_certs(&self.team).await.map_err(sideload::signing_error)
+    }
+
+    async fn retrieve(&mut self) -> anyhow::Result<CertificateIdentity> {
+        CertificateIdentity::retrieve(
+            "SideRelay", &self.apple_id, &mut self.session, &self.team, &self.storage,
+            &MaxCertsBehavior::<MaxCertsCallbackBox>::Error,
+        ).await.map_err(sideload::signing_error)
+    }
+}
+
+async fn latest_limit_job(state: &AppState, job_id: &str) -> anyhow::Result<(String, String)> {
+    sqlx::query_as(
+        "SELECT j.app_id, a.account_id FROM jobs j JOIN apps a ON a.id = j.app_id
+         WHERE j.id = ? AND j.status = 'failed' AND instr(j.error, ?) = 1 AND a.account_id IS NOT NULL
+           AND NOT EXISTS (SELECT 1 FROM jobs newer WHERE newer.app_id = j.app_id
+                           AND newer.rowid > j.rowid AND newer.status != 'cancelled')",
+    ).bind(job_id).bind(CERTIFICATE_LIMIT).fetch_optional(&state.db).await?
+        .context("Run the installation or refresh again to review a current certificate limit.")
+}
+
+async fn candidates(
+    state: &AppState, account_id: &str, team_id: &str, entries: &[DevelopmentCertificate],
+) -> anyhow::Result<Vec<Candidate>> {
+    let mut result = Vec::new();
+    for entry in entries {
+        let Some(serial) = entry.serial_number.as_deref().filter(|serial| {
+            !serial.is_empty() && serial.bytes().all(|byte| byte.is_ascii_hexdigit())
+        }) else { continue };
+        let normalized = serial.trim_start_matches('0').to_ascii_uppercase();
+        let rows = sqlx::query_as::<_, (String, String, String, Option<String>, Option<String>)>(
+            "SELECT a.id, a.display_name, d.name, a.signing_serial, a.ipa_path
+             FROM apps a JOIN devices d ON d.id = a.device_id
+             LEFT JOIN apple_accounts c ON c.id = a.account_id
+             WHERE a.installed_at IS NOT NULL AND
+               ((a.signing_team = ? AND a.signing_serial = ?) OR
+                (a.signing_serial IS NULL AND (c.team_id = ? OR a.account_id = ?)))
+             ORDER BY a.display_name, d.name, a.id",
+        ).bind(team_id).bind(&normalized).bind(team_id).bind(account_id)
+            .fetch_all(&state.db).await?;
+        let apps = rows.into_iter().map(|(id, name, device, signed, ipa)| Impact {
+            id, name, device, certain: signed.is_some(),
+            can_repair: ipa.as_deref().is_some_and(|path| std::path::Path::new(path).is_file()),
+        }).collect();
+        let label = entry.machine_name.as_deref().filter(|name| !name.trim().is_empty())
+            .or(entry.name.as_deref()).unwrap_or("Apple Development");
+        let label = match entry.expiration_date {
+            Some(date) => {
+                let expiration: chrono::DateTime<chrono::Utc> = std::time::SystemTime::from(date).into();
+                format!("{label} (serial {serial}, expires {})", expiration.format("%Y-%m-%d"))
+            }
+            None => format!("{label} (serial {serial})"),
+        };
+        result.push(Candidate { serial: serial.to_owned(), label, apps });
+    }
+    result.sort_by(|left, right| left.serial.cmp(&right.serial));
+    Ok(result)
+}
+
+pub async fn review(state: &AppState, job_id: &str) -> anyhow::Result<Review> {
+    let _signing = state.signing.lock().await;
+    let (app_id, account_id) = latest_limit_job(state, job_id).await?;
+    let mut apple = AppleContext::open(state, &account_id).await?;
+    let entries = apple.certificates().await?;
+    ensure!(CertificateIdentity::reuse(&apple.team, &apple.storage, &apple.apple_id, &entries)
+        .map_err(sideload::signing_error)?.is_none(),
+        "SideRelay now has a reusable certificate. Retry the installation or refresh.");
+    let certificates = candidates(state, &account_id, &apple.team.team_id, &entries).await?;
+    ensure!(!certificates.is_empty(), "Apple returned no certificate with a usable serial. Retry later.");
+    let mut plans = state.certificate_plans.lock().await;
+    let now = Instant::now();
+    plans.retain(|_, plan| plan.expires > now && plan.team_id != apple.team.team_id);
+    let token = Uuid::new_v4().to_string();
+    plans.insert(token.clone(), Plan {
+        expires: now + PLAN_DURATION, account_id, app_id, job_id: job_id.to_owned(),
+        team_id: apple.team.team_id, certificates: certificates.clone(),
+    });
+    Ok(Review { token, certificates })
+}
+
+#[derive(Deserialize, Serialize)]
+pub struct Replacement {
+    pub revoked: bool,
+    pub queued_repairs: usize,
+    pub retry_job: Option<String>,
+}
+
+pub fn verify_confirmation(token: &str, serial: &str, approval: &str) -> anyhow::Result<()> {
+    use hmac::{Hmac, KeyInit, Mac};
+    let key = std::env::var("JAS_SECRET_KEY").context("SideRelay service key is missing.")?;
+    let mut mac = Hmac::<sha2::Sha256>::new_from_slice(key.as_bytes())?;
+    mac.update(format!("SideRelay certificate replacement\n{token}\n{serial}").as_bytes());
+    let tag = hex::decode(approval).context("Native confirmation is required.")?;
+    mac.verify_slice(&tag).map_err(|_| anyhow!("Native confirmation is required."))
+}
+
+pub async fn replace(state: &AppState, token: &str, serial: &str) -> anyhow::Result<Replacement> {
+    let _signing = state.signing.lock().await;
+    let plan = state.certificate_plans.lock().await.remove(token)
+        .filter(|plan| plan.expires > Instant::now())
+        .context("This review expired. Review the certificates again.")?;
+    let selected = plan.certificates.iter().find(|entry| entry.serial == serial)
+        .context("The selected certificate was not included in this review.")?;
+    ensure!(latest_limit_job(state, &plan.job_id).await? == (plan.app_id.clone(), plan.account_id.clone()),
+        "The operation changed. Review the certificates again.");
+    let device = db::get_app(&state.db, &plan.app_id).await?.context("App not found.")?;
+    let device = db::get_device(&state.db, &device.device_id).await?.context("Device not found.")?;
+    sideload::tcp_ping(&device.ip, device.mdns_ip.as_deref()).await
+        .map_err(|error| sideload::PairingUnreachable(error.to_string()))?;
+
+    let mut apple = AppleContext::open(state, &plan.account_id).await?;
+    ensure!(apple.team.team_id == plan.team_id, "The developer team changed. Review the certificates again.");
+
+    // Retry first. A certificate may have become reusable, or a slot may now be free.
+    let revoked = match apple.retrieve().await {
+        Ok(identity) => {
+            mark_orphans(&state.db, &plan.team_id, &identity.active_serials).await?;
+            false
+        }
+        Err(error) if error.to_string().starts_with(CERTIFICATE_LIMIT) => {
+            let entries = apple.certificates().await?;
+            ensure!(candidates(state, &plan.account_id, &plan.team_id, &entries).await? == plan.certificates,
+                "The certificate list or affected apps changed. Review the certificates again.");
+            let mut tx = state.db.begin().await?;
+            let mut marked = Vec::new();
+            for app in selected.apps.iter().filter(|app| app.certain) {
+                let updated = sqlx::query("UPDATE apps SET signing_repair = ? WHERE id = ? AND signing_repair IS NULL")
+                    .bind(&selected.label).bind(&app.id).execute(&mut *tx).await?;
+                if updated.rows_affected() == 1 { marked.push(&app.id); }
+            }
+            tx.commit().await?;
+            let result = apple.session.revoke_development_cert(&apple.team, serial, None).await;
+            if let Err(error) = result {
+                tracing::error!("Apple did not confirm revocation of {serial}: {error}");
+                if apple.certificates().await.is_ok_and(|entries| entries.iter().any(|entry|
+                    entry.serial_number.as_deref() == Some(serial)
+                        && !entry.status.as_deref().is_some_and(|status| status.eq_ignore_ascii_case("revoked"))
+                )) {
+                    for id in marked {
+                        sqlx::query("UPDATE apps SET signing_repair = NULL WHERE id = ? AND signing_repair = ?")
+                            .bind(id).bind(&selected.label).execute(&state.db).await?;
+                    }
+                    return Err(anyhow!("Apple still lists the certificate after the failed revocation. The replacement was stopped."));
+                }
+                return Err(anyhow!("Apple did not confirm whether the certificate was revoked. SideRelay has kept the recovery status for affected apps."));
+            }
+            tracing::warn!("Revoked certificate {serial} after explicit confirmation");
+            let identity = apple.retrieve().await.map_err(|error| {
+                tracing::error!("Certificate {serial} revoked; creating the replacement failed: {error}");
+                anyhow!("The certificate was revoked. SideRelay could not prepare its replacement: {error}. The affected apps are marked for recovery.")
+            })?;
+            mark_orphans(&state.db, &plan.team_id, &identity.active_serials).await?;
+            true
+        }
+        Err(error) => return Err(error),
+    };
+
+    let queued_repairs = enqueue_repairs(state).await?;
+    let retry_job = retry_failed_operation(state, &plan).await?;
+    Ok(Replacement { revoked, queued_repairs, retry_job })
+}
+
+async fn retry_failed_operation(state: &AppState, plan: &Plan) -> anyhow::Result<Option<String>> {
+    let Some(app) = db::get_app(&state.db, &plan.app_id).await? else { return Ok(None) };
+    let Some(ipa_path) = app.ipa_path.filter(|path| std::path::Path::new(path).is_file())
+        else { return Ok(None) };
+    let job_id = Uuid::new_v4().to_string();
+    let (kind, job_kind) = if app.installed_at.is_some() {
+        ("refresh", JobKind::Refresh)
+    } else {
+        ("install", JobKind::Install { ipa_path, temporary: false })
+    };
+    let inserted = sqlx::query(
+        "INSERT INTO jobs (id, app_id, kind, status)
+         SELECT ?, ?, ?, 'queued' WHERE NOT EXISTS (
+             SELECT 1 FROM jobs WHERE app_id = ? AND status IN ('queued', 'running'))",
+    ).bind(&job_id).bind(&app.id).bind(kind).bind(&app.id).execute(&state.db).await?;
+    if inserted.rows_affected() == 0 { return Ok(None) }
+    send_jobs(state, vec![JobRequest {
+        job_id: job_id.clone(), app_id: app.id, device_id: app.device_id,
+        account_id: plan.account_id.clone(), kind: job_kind,
+    }]);
+    Ok(Some(job_id))
+}
+
+pub async fn mark_orphans(pool: &sqlx::SqlitePool, team: &str, active: &[String]) -> anyhow::Result<usize> {
+    let rows = sqlx::query_as::<_, (String, String)>(
+        "SELECT id, signing_serial FROM apps WHERE signing_team = ? AND signing_serial IS NOT NULL
+           AND installed_at IS NOT NULL AND signing_repair IS NULL",
+    ).bind(team).fetch_all(pool).await?;
+    let mut count = 0;
+    for (id, serial) in rows {
+        if active.contains(&serial) { continue }
+        sqlx::query("UPDATE apps SET signing_repair = ? WHERE id = ? AND signing_repair IS NULL")
+            .bind(serial).bind(id).execute(pool).await?;
+        count += 1;
+    }
+    Ok(count)
+}
+
+pub async fn enqueue_repairs(state: &AppState) -> anyhow::Result<usize> {
+    let rows = sqlx::query_as::<_, (String, String, String, String)>(
+        "SELECT a.id, a.device_id, COALESCE(
+             (SELECT c.id FROM apple_accounts c WHERE c.id = a.account_id
+                AND (a.signing_team IS NULL OR a.signing_team = c.team_id)),
+             (SELECT c.id FROM apple_accounts c WHERE c.team_id = a.signing_team ORDER BY c.id LIMIT 1)
+         ) AS account, a.ipa_path
+         FROM apps a WHERE a.signing_repair IS NOT NULL AND a.ipa_path IS NOT NULL AND account IS NOT NULL",
+    ).fetch_all(&state.db).await?;
+    let mut requests = Vec::new();
+    for (app_id, device_id, account_id, ipa_path) in rows {
+        if !std::path::Path::new(&ipa_path).is_file() { continue }
+        let job_id = Uuid::new_v4().to_string();
+        let inserted = sqlx::query(
+            "INSERT INTO jobs (id, app_id, kind, status)
+             SELECT ?, ?, 're-sign', 'queued' WHERE NOT EXISTS (
+                 SELECT 1 FROM jobs WHERE app_id = ? AND status IN ('queued', 'running'))",
+        ).bind(&job_id).bind(&app_id).bind(&app_id).execute(&state.db).await?;
+        if inserted.rows_affected() == 1 {
+            requests.push(JobRequest { job_id, app_id, device_id, account_id, kind: JobKind::Repair });
+        }
+    }
+    let count = requests.len();
+    send_jobs(state, requests);
+    Ok(count)
+}
+
+fn send_jobs(state: &AppState, requests: Vec<JobRequest>) {
+    let state = state.clone();
+    tokio::spawn(async move {
+        for request in requests {
+            let job = request.job_id.clone();
+            if state.job_tx.send(request).await.is_err() {
+                let _ = db::update_job_status(&state.db, &job, "failed", Some("Could not queue the operation.")).await;
+            }
+        }
+    });
+}
