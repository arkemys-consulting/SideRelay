+pub fn installation_error(error: idevice::IdeviceError, main_profile: bool) -> anyhow::Error {
+    if let idevice::IdeviceError::ApplicationVerificationFailed(detail) = &error {
+        if detail.to_ascii_lowercase().contains("maximum number of installed apps") {
+            return anyhow::anyhow!("{INSTALL_LIMIT} {detail}");
+        }
+        if main_profile {
+            return anyhow::anyhow!("[main-profile-verification] {detail}");
+        }
+    }
+    if matches!(&error, idevice::IdeviceError::Socket(_) | idevice::IdeviceError::NoEstablishedConnection) {
+        return PairingUnreachable(format!("Installation connection dropped: {error}")).into();
+    }
+    anyhow::anyhow!("instproxy install failed: {error:?}")
+}
