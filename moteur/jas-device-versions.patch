+/// Read the version through the same trusted transport used by installation.
+pub async fn product_version(device: &DeviceRow, crypto: &Crypto) -> anyhow::Result<String> {
+    let value = match DeviceConnection::open(device, crypto).await? {
+        DeviceConnection::Usb(provider) => {
+            let mut lockdown = LockdownClient::connect(&provider).await?;
+            lockdown.get_value(Some("ProductVersion"), None::<&str>).await?
+        }
+        DeviceConnection::Network(mut handle, mut handshake) => {
+            let mut lockdown = handshake.connect::<LockdownClient>(&mut handle).await?;
+            lockdown.get_value(Some("ProductVersion"), None::<&str>).await?
+        }
+    };
+    let version = value.as_string().unwrap_or_default();
+    anyhow::ensure!(!version.is_empty() && version.len() <= 32 && version.split('.').all(
+        |part| !part.is_empty() && part.bytes().all(|byte| byte.is_ascii_digit())
+    ), "The device did not return a numeric OS version.");
+    Ok(version.to_owned())
+}
