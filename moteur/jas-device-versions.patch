+#[cfg(feature = "ssr")]
+#[server(endpoint = "/ios_device_versions11318273670462819093")]
+pub async fn ios_device_versions() -> Result<std::collections::BTreeMap<String, String>, ServerFnError> {
+    use crate::server::{db, sideload, state::AppState};
+    use std::{sync::Arc, time::Duration};
+    use tokio::{sync::Semaphore, task::JoinSet, time::{Instant, timeout_at}};
+
+    let headers: axum::http::HeaderMap = leptos_axum::extract().await?;
+    if headers.get("X-SideRelay-Device").and_then(|value| value.to_str().ok()) != Some("1") {
+        return Err(ServerFnError::new("Open Devices in SideRelay."));
+    }
+    let state = leptos::prelude::use_context::<AppState>().ok_or_else(|| ServerFnError::new("No state"))?;
+    let devices = db::list_devices(&state.db).await.map_err(|error| ServerFnError::new(error.to_string()))?;
+    let deadline = Instant::now() + Duration::from_secs(5);
+    let slots = Arc::new(Semaphore::new(6));
+    let mut pending = JoinSet::new();
+    for device in devices.into_iter().filter(|device| !device.is_tvos()) {
+        let crypto = state.crypto.clone();
+        let slots = slots.clone();
+        pending.spawn(async move {
+            let _slot = slots.acquire().await.ok()?;
+            let version = sideload::product_version(&device, &crypto).await.ok()?;
+            Some((device.id, version))
+        });
+    }
+    let mut versions = std::collections::BTreeMap::new();
+    while let Ok(Some(result)) = timeout_at(deadline, pending.join_next()).await {
+        if let Ok(Some((id, version))) = result {
+            versions.insert(id, version);
+        }
+    }
+    Ok(versions)
+}
