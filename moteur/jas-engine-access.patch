diff --git a/src/local_access.rs b/src/local_access.rs
new file mode 100644
index 0000000..3f96402
--- /dev/null
+++ b/src/local_access.rs
@@ -0,0 +1,63 @@
+use axum::{
+    extract::{Request, State},
+    http::{HeaderMap, Method, StatusCode, header},
+    middleware::Next,
+    response::{IntoResponse, Response},
+};
+use subtle::ConstantTimeEq;
+
+pub struct LocalAccess {
+    token: String,
+    authority: String,
+    origin: String,
+}
+
+impl LocalAccess {
+    pub fn new(token: String, port: u16) -> Option<Self> {
+        if token.len() != 64 || !token.bytes().all(|byte| byte.is_ascii_hexdigit()) {
+            return None;
+        }
+        let authority = format!("127.0.0.1:{port}");
+        let origin = format!("http://{authority}");
+        Some(Self { token, authority, origin })
+    }
+
+    fn same_token(&self, candidate: &str) -> bool {
+        bool::from(self.token.as_bytes().ct_eq(candidate.as_bytes()))
+    }
+
+    fn allows(&self, method: &Method, headers: &HeaderMap) -> bool {
+        let value = |name| headers.get(name).and_then(|v| v.to_str().ok());
+        if headers.get(header::HOST).and_then(|v| v.to_str().ok()) != Some(&self.authority)
+            || value("sec-fetch-site").is_some_and(|site| site != "same-origin" && site != "none")
+            || headers.get(header::ORIGIN).is_some_and(|origin| origin != self.origin.as_str())
+        {
+            return false;
+        }
+
+        if value("x-siderelay-engine").is_some_and(|token| self.same_token(token)) {
+            return true;
+        }
+        if !matches!(*method, Method::GET | Method::HEAD)
+            && headers.get(header::ORIGIN).is_none()
+        {
+            return false;
+        }
+        headers.get_all(header::COOKIE).iter().filter_map(|value| value.to_str().ok())
+            .flat_map(|value| value.split(';'))
+            .filter_map(|item| item.trim().split_once('='))
+            .any(|(name, token)| name == "siderelay_engine" && self.same_token(token))
+    }
+}
+
+pub async fn require(
+    State(access): State<std::sync::Arc<LocalAccess>>,
+    request: Request,
+    next: Next,
+) -> Response {
+    if access.allows(request.method(), request.headers()) {
+        next.run(request).await
+    } else {
+        StatusCode::FORBIDDEN.into_response()
+    }
+}
