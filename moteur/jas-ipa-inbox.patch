diff --git a/src/server/inbox.rs b/src/server/inbox.rs
new file mode 100644
index 0000000..a912a65
--- /dev/null
+++ b/src/server/inbox.rs
@@ -0,0 +1,125 @@
+use std::{
+    collections::HashMap,
+    os::unix::fs::{DirBuilderExt, MetadataExt},
+    path::{Path, PathBuf},
+    time::Duration,
+};
+use tokio::{fs, io::AsyncReadExt};
+
+use super::{library, sideload, state::AppState};
+
+fn fingerprint(meta: &std::fs::Metadata) -> String {
+    format!("{}:{}:{}:{}:{}:{}:{}", meta.dev(), meta.ino(), meta.len(),
+        meta.mtime(), meta.mtime_nsec(), meta.ctime(), meta.ctime_nsec())
+}
+
+async fn selected_directory(default: &Path, preference: Option<&Path>) -> anyhow::Result<PathBuf> {
+    if let Some(preference) = preference {
+        match fs::read_to_string(preference).await {
+            Ok(value) => {
+                let selected = PathBuf::from(value);
+                anyhow::ensure!(selected.is_absolute(), "Invalid IPA Inbox path.");
+                return Ok(selected);
+            }
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+            Err(error) => return Err(error.into()),
+        }
+    }
+    let mut builder = std::fs::DirBuilder::new();
+    builder.mode(0o700);
+    match builder.create(default) {
+        Ok(()) => {}
+        Err(error) if error.kind() == std::io::ErrorKind::AlreadyExists => {}
+        Err(error) => return Err(error.into()),
+    }
+    Ok(default.into())
+}
+
+pub async fn watch(state: AppState, default: PathBuf, preference: Option<PathBuf>) {
+    let mut active = PathBuf::new();
+    let mut previous = HashMap::new();
+    let mut timer = tokio::time::interval(Duration::from_secs(4));
+    timer.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Skip);
+    loop {
+        timer.tick().await;
+        let directory = match selected_directory(&default, preference.as_deref()).await {
+            Ok(directory) => directory,
+            Err(error) => {
+                tracing::warn!("Could not determine the IPA Inbox: {error}");
+                continue;
+            }
+        };
+        if directory != active {
+            previous.clear();
+            active = directory.clone();
+        }
+        if let Err(error) = scan(&state, &directory, &mut previous).await {
+            tracing::warn!("Could not check IPA Inbox: {error}");
+        }
+    }
+}
+
+async fn scan(state: &AppState, directory: &Path, previous: &mut HashMap<String, String>) -> anyhow::Result<()> {
+    let mut current = HashMap::new();
+    anyhow::ensure!(fs::symlink_metadata(directory).await?.is_dir(), "IPA Inbox must be a directory.");
+    let mut entries = fs::read_dir(directory).await?;
+    let saved: HashMap<String, String> = sqlx::query_as("SELECT name, fingerprint FROM ipa_inbox")
+        .fetch_all(&state.db).await?.into_iter().collect();
+
+    while let Some(entry) = entries.next_entry().await? {
+        let path = entry.path();
+        let name = entry.file_name();
+        let Some(name) = name.to_str().filter(|name| !name.starts_with('.')) else { continue };
+        if !path.extension().is_some_and(|extension| extension.eq_ignore_ascii_case("ipa")) { continue; }
+        let Ok(meta) = fs::symlink_metadata(&path).await else { continue };
+        if !meta.is_file() { continue; }
+        let observed = fingerprint(&meta);
+        if previous.get(name) == Some(&observed) && saved.get(name) != Some(&observed) {
+            if let Err(error) = import(state, &path, name, &observed).await {
+                tracing::warn!("Could not import {name:?} from IPA Inbox: {error}");
+            }
+        }
+        current.insert(name.to_owned(), observed);
+    }
+
+    for name in saved.keys().filter(|name| !current.contains_key(*name)) {
+        sqlx::query("DELETE FROM ipa_inbox WHERE name = ?")
+            .bind(name).execute(&state.db).await?;
+    }
+    *previous = current;
+    Ok(())
+}
+
+async fn import(state: &AppState, path: &Path, name: &str, observed: &str) -> anyhow::Result<()> {
+    let mut file = fs::File::open(path).await?;
+    let meta = file.metadata().await?;
+    if !meta.is_file() || fingerprint(&meta) != observed { return Ok(()); }
+    let (package_id, error) = if meta.len() > library::MAX_IPA as u64 {
+        (None, Some("The IPA is larger than 512 MB.".to_owned()))
+    } else {
+        let mut bytes = Vec::new();
+        (&mut file).take(library::MAX_IPA as u64 + 1).read_to_end(&mut bytes).await?;
+        if bytes.len() as u64 != meta.len() || fingerprint(&file.metadata().await?) != observed
+            || fingerprint(&fs::symlink_metadata(path).await?) != observed {
+            return Ok(());
+        }
+        let (bytes, info) = tokio::task::spawn_blocking(move || {
+            let info = sideload::read_ipa_info(&bytes);
+            (bytes, info)
+        }).await?;
+        match info {
+            Ok(info) => {
+                let (package, _) = library::archive(state, &bytes, info, None).await?;
+                (Some(package.id), None)
+            }
+            Err(error) => (None, Some(error.to_string().chars().take(300).collect())),
+        }
+    };
+
+    sqlx::query(
+        "INSERT INTO ipa_inbox (name, fingerprint, package_id, error) VALUES (?, ?, ?, ?)
+         ON CONFLICT(name) DO UPDATE SET fingerprint = excluded.fingerprint,
+         package_id = excluded.package_id, error = excluded.error",
+    ).bind(name).bind(observed).bind(package_id).bind(error).execute(&state.db).await?;
+    Ok(())
+}
