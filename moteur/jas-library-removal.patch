+pub async fn remove_library_ipa(package_id: String) -> Result<(), ServerFnError> {
+    let headers: axum::http::HeaderMap = leptos_axum::extract().await?;
+    if headers.get("X-SideRelay-Library").and_then(|value| value.to_str().ok()) != Some("remove") {
+        return Err(ServerFnError::new("Use SideRelay’s Library to remove an IPA."));
+    }
+    let state = leptos::prelude::use_context::<crate::server::state::AppState>()
+        .ok_or_else(|| ServerFnError::new("No state"))?;
+    crate::server::library::remove_package(&state, &package_id).await
+        .map_err(|error| ServerFnError::new(error.to_string()))
+}
