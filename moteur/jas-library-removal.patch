+pub async fn remove_package(state: &AppState, id: &str) -> anyhow::Result<()> {
+    let mut tx = state.db.begin_with("BEGIN IMMEDIATE").await?;
+    let path: String = sqlx::query_scalar("SELECT path FROM ipa_packages WHERE id = ?")
+        .bind(id).fetch_optional(&mut *tx).await?.context("This IPA is no longer in Library.")?;
+    let current: Option<String> = sqlx::query_scalar(
+        "SELECT display_name FROM apps WHERE ipa_path = ? LIMIT 1",
+    ).bind(&path).fetch_optional(&mut *tx).await?;
+    if let Some(app) = current {
+        anyhow::bail!("{app} still uses this saved IPA for refresh or retry. Remove another build, or install a replacement build first.");
+    }
+    let busy: bool = sqlx::query_scalar(
+        "SELECT EXISTS(SELECT 1 FROM jobs WHERE install_ipa_path = ? AND status IN ('queued', 'running', 'pending'))
+             OR EXISTS(SELECT 1 FROM ipa_batch_items WHERE package_id = ? AND status IN ('queued', 'running', 'pending'))",
+    ).bind(&path).bind(id).fetch_one(&mut *tx).await?;
+    ensure!(!busy, "This IPA is in use. Wait for the operation to finish and try again.");
+
+    // Keep the package's metadata so completed batches and installation history still resolve.
+    sqlx::query("UPDATE ipa_packages SET removed_at = COALESCE(removed_at, unixepoch()) WHERE id = ?")
+        .bind(id).execute(&mut *tx).await?;
+    let saved = Path::new(&path);
+    let managed = Path::new(&state.config.storage.ipa_dir);
+    if let Ok(file) = tokio::fs::canonicalize(saved).await {
+        // A legacy entry can point to an external IPA. Only delete managed copies.
+        if saved.extension().is_some_and(|extension| extension == "ipa")
+            && tokio::fs::canonicalize(managed).await.is_ok_and(|folder| file.starts_with(folder))
+        {
+            tokio::fs::remove_file(saved).await.context("Could not remove the saved IPA.")?;
+        }
+    } else {
+        match tokio::fs::symlink_metadata(saved).await {
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+            Err(error) => return Err(error).context("Could not access the saved IPA."),
+            Ok(metadata) => ensure!(metadata.is_symlink(), "Could not resolve the saved IPA."),
+        }
+    }
+    tx.commit().await?;
+    Ok(())
+}
