diff --git a/src/server/batches.rs b/src/server/batches.rs
new file mode 100644
index 0000000..44e5672
--- /dev/null
+++ b/src/server/batches.rs
@@ -0,0 +1,222 @@
+use std::{collections::HashSet, path::PathBuf, time::Duration};
+
+use anyhow::{Context, ensure};
+use serde::{Deserialize, Serialize};
+use uuid::Uuid;
+
+use super::{export, library, state::AppState};
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Selection {
+    package_id: String,
+    target_app_id: Option<String>,
+}
+
+#[derive(Serialize, sqlx::FromRow)]
+#[serde(rename_all = "camelCase")]
+pub struct Batch {
+    id: String,
+    mode: String,
+    device_name: String,
+    account_name: String,
+    created_at: i64,
+    total: i64,
+    succeeded: i64,
+    failed: i64,
+}
+
+#[derive(Serialize, sqlx::FromRow)]
+#[serde(rename_all = "camelCase")]
+struct Item {
+    position: i64,
+    name: String,
+    version: Option<String>,
+    status: String,
+    error: Option<String>,
+    progress: Option<i64>,
+    stage: Option<String>,
+    output_file: Option<String>,
+}
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Status {
+    #[serde(flatten)]
+    batch: Batch,
+    items: Vec<Item>,
+}
+
+const BATCH_COUNTS: &str =
+    "SELECT b.id, b.mode, b.device_name, b.account_name, b.created_at,
+            count(i.position) AS total,
+            count(CASE WHEN i.status = 'done' THEN 1 END) AS succeeded,
+            count(CASE WHEN i.status = 'failed' THEN 1 END) AS failed
+     FROM ipa_batches b JOIN ipa_batch_items i ON i.batch_id = b.id";
+
+pub async fn list(state: &AppState) -> anyhow::Result<Vec<Batch>> {
+    let query = format!("{BATCH_COUNTS} GROUP BY b.id ORDER BY b.created_at DESC, b.rowid DESC LIMIT 40");
+    Ok(sqlx::query_as(&query).fetch_all(&state.db).await?)
+}
+
+pub async fn status(state: &AppState, id: &str) -> anyhow::Result<Status> {
+    let query = format!("{BATCH_COUNTS} WHERE b.id = ? GROUP BY b.id");
+    let batch = sqlx::query_as(&query).bind(id).fetch_optional(&state.db).await?
+        .context("This batch could not be found.")?;
+    let items = sqlx::query_as(
+        "SELECT i.position, i.name, i.version, i.status, i.error, j.progress, j.stage, i.output_file
+         FROM ipa_batch_items i LEFT JOIN jobs j ON j.id = i.job_id
+         WHERE i.batch_id = ? ORDER BY i.position",
+    ).bind(id).fetch_all(&state.db).await?;
+    Ok(Status { batch, items })
+}
+
+pub async fn start(
+    state: &AppState, mode: &str, device_id: &str, account_id: &str, packages: Vec<Selection>,
+) -> anyhow::Result<String> {
+    ensure!(matches!(mode, "sign" | "install"), "Select a batch operation.");
+    ensure!((1..=32).contains(&packages.len()), "Select between 1 and 32 IPAs.");
+    let device: String = sqlx::query_scalar("SELECT name FROM devices WHERE id = ?")
+        .bind(device_id).fetch_optional(&state.db).await?.context("Select a paired iPhone or iPad.")?;
+    let account: String = sqlx::query_scalar("SELECT apple_id FROM apple_accounts WHERE id = ?")
+        .bind(account_id).fetch_optional(&state.db).await?.context("Select an Apple Account.")?;
+    let mut chosen = HashSet::new();
+    let mut bundles = HashSet::new();
+    let mut items = Vec::with_capacity(packages.len());
+    for package in packages {
+        ensure!(chosen.insert(package.package_id.clone()), "Select each IPA once.");
+        let (_, info) = library::load_package(state, &package.package_id).await?;
+        if mode == "install" {
+            ensure!(bundles.insert(info.bundle_id), "Select one version of each app to install.");
+        }
+        items.push((package, info.display_name, info.version));
+    }
+    let id = Uuid::new_v4().to_string();
+    let mut tx = state.db.begin().await?;
+    sqlx::query(
+        "INSERT INTO ipa_batches (id, mode, device_id, account_id, device_name, account_name, created_at)
+         VALUES (?, ?, ?, ?, ?, ?, unixepoch())",
+    ).bind(&id).bind(mode).bind(device_id).bind(account_id).bind(device).bind(account)
+        .execute(&mut *tx).await?;
+    for (position, (package, name, version)) in items.into_iter().enumerate() {
+        sqlx::query(
+            "INSERT INTO ipa_batch_items (batch_id, position, package_id, name, version, target_app_id, status)
+             VALUES (?, ?, ?, ?, ?, ?, 'queued')",
+        ).bind(&id).bind(position as i64).bind(package.package_id).bind(name).bind(version)
+            .bind(package.target_app_id).execute(&mut *tx).await?;
+    }
+    tx.commit().await?;
+    spawn(state, id.clone());
+    Ok(id)
+}
+
+pub async fn retry(state: &AppState, id: &str) -> anyhow::Result<()> {
+    let mut tx = state.db.begin_with("BEGIN IMMEDIATE").await?;
+    let active: bool = sqlx::query_scalar(
+        "SELECT EXISTS(SELECT 1 FROM ipa_batch_items WHERE batch_id = ? AND status IN ('queued', 'running'))",
+    ).bind(id).fetch_one(&mut *tx).await?;
+    ensure!(!active, "Wait for the batch to finish before retrying failed items.");
+    let change = sqlx::query(
+        "UPDATE ipa_batch_items SET status = 'queued', error = NULL, job_id = NULL
+         WHERE batch_id = ? AND status = 'failed'",
+    ).bind(id).execute(&mut *tx).await?;
+    ensure!(change.rows_affected() > 0, "This batch has no failed items to retry.");
+    tx.commit().await?;
+    spawn(state, id.to_owned());
+    Ok(())
+}
+
+pub async fn recover(state: &AppState) -> anyhow::Result<()> {
+    sqlx::query(
+        "UPDATE ipa_batch_items SET status = 'done'
+         WHERE status = 'running' AND job_id IN (SELECT id FROM jobs WHERE status = 'done')",
+    ).execute(&state.db).await?;
+    sqlx::query(
+        "UPDATE ipa_batch_items SET status = 'failed', error = 'SideRelay restarted. Retry this item.'
+         WHERE status IN ('queued', 'running')",
+    ).execute(&state.db).await?;
+    Ok(())
+}
+
+fn spawn(state: &AppState, id: String) {
+    let state = state.clone();
+    tokio::spawn(async move {
+        let _turn = state.batch.lock().await;
+        if let Err(error) = run(&state, &id).await {
+            tracing::error!("Could not run batch {id}: {error}");
+            let _ = sqlx::query(
+                "UPDATE ipa_batch_items SET status = 'failed', error = 'SideRelay could not finish this batch.'
+                 WHERE batch_id = ? AND status IN ('queued', 'running')",
+            ).bind(id).execute(&state.db).await;
+        }
+    });
+}
+
+#[derive(sqlx::FromRow)]
+struct PendingItem {
+    position: i64,
+    package_id: String,
+    target_app_id: Option<String>,
+}
+
+async fn run(state: &AppState, id: &str) -> anyhow::Result<()> {
+    let (mode, device_id, account_id): (String, String, String) = sqlx::query_as(
+        "SELECT mode, device_id, account_id FROM ipa_batches WHERE id = ?",
+    ).bind(id).fetch_one(&state.db).await?;
+    let queued: Vec<PendingItem> = sqlx::query_as(
+        "SELECT position, package_id, target_app_id FROM ipa_batch_items
+         WHERE batch_id = ? AND status = 'queued' ORDER BY position",
+    ).bind(id).fetch_all(&state.db).await?;
+    for item in queued {
+        sqlx::query("UPDATE ipa_batch_items SET status = 'running' WHERE batch_id = ? AND position = ?")
+            .bind(id).bind(item.position).execute(&state.db).await?;
+        let result = if mode == "sign" {
+            sign(state, id, &device_id, &account_id, &item).await.map(Some)
+        } else {
+            install(state, id, &device_id, &account_id, &item).await.map(|()| None)
+        };
+        let (status, output, error) = match result {
+            Ok(output) => ("done", output, None),
+            Err(error) => ("failed", None, Some(error.to_string())),
+        };
+        sqlx::query("UPDATE ipa_batch_items SET status = ?, output_file = ?, error = ? WHERE batch_id = ? AND position = ?")
+            .bind(status).bind(output).bind(error).bind(id).bind(item.position).execute(&state.db).await?;
+    }
+    Ok(())
+}
+
+async fn sign(
+    state: &AppState, id: &str, device: &str, account: &str, item: &PendingItem,
+) -> anyhow::Result<String> {
+    let (path, info) = library::load_package(state, &item.package_id).await?;
+    let signed = export::sign_for_device(state, device, account, &path).await?;
+    let name: String = info.display_name.chars().take(80).map(|character| {
+        if character.is_ascii_alphanumeric() || matches!(character, '-' | '_' | ' ') {
+            character
+        } else {
+            '_'
+        }
+    }).collect();
+    let file = format!("{:02}-{}.ipa", item.position + 1, name.trim());
+    let destination = PathBuf::from(&state.config.storage.ipa_dir).join("signed").join(id).join(&file);
+    library::write_archive(&destination, &signed.bytes).await?;
+    Ok(file)
+}
+
+async fn install(
+    state: &AppState, id: &str, device: &str, account: &str, item: &PendingItem,
+) -> anyhow::Result<()> {
+    let (path, info) = library::load_package(state, &item.package_id).await?;
+    let job_id = library::queue_install_linked(
+        state, device, account, &path, false, &info, item.target_app_id.as_deref(), Some((id, item.position)),
+    ).await?;
+    loop {
+        let job = super::db::get_job(&state.db, &job_id).await?.context("The installation was removed from Activity.")?;
+        match job.status.as_str() {
+            "done" => return Ok(()),
+            "failed" | "cancelled" | "canceled" => anyhow::bail!(
+                "{}", job.error.as_deref().unwrap_or("The installation was cancelled.")),
+            _ => tokio::time::sleep(Duration::from_millis(500)).await,
+        }
+    }
+}
