+CREATE TABLE ipa_batches (
+    id TEXT PRIMARY KEY,
+    mode TEXT NOT NULL CHECK (mode IN ('sign', 'install')),
+    device_id TEXT NOT NULL,
+    account_id TEXT NOT NULL,
+    device_name TEXT NOT NULL,
+    account_name TEXT NOT NULL,
+    created_at INTEGER NOT NULL
+);
+
+CREATE TABLE ipa_batch_items (
+    batch_id TEXT NOT NULL REFERENCES ipa_batches(id) ON DELETE CASCADE,
+    position INTEGER NOT NULL,
+    package_id TEXT NOT NULL REFERENCES ipa_packages(id),
+    name TEXT NOT NULL,
+    version TEXT,
+    target_app_id TEXT,
+    status TEXT NOT NULL CHECK (status IN ('queued', 'running', 'done', 'failed')),
+    error TEXT,
+    job_id TEXT,
+    output_file TEXT,
+    PRIMARY KEY (batch_id, position),
+    UNIQUE (batch_id, package_id)
+);
