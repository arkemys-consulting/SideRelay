+#[cfg(test)]
+mod renewal_tests {
+    use super::*;
+    use crate::server::sideload::PAIRING_UNREACHABLE;
+
+    const NOW: i64 = 2_000_000_000;
+    const DAY: i64 = 86_400;
+    const RETRY: i64 = 7_200;
+
+    async fn database() -> SqlitePool {
+        let pool = sqlx::sqlite::SqlitePoolOptions::new()
+            .max_connections(1)
+            .connect("sqlite::memory:")
+            .await
+            .unwrap();
+        sqlx::migrate!("./migrations").run(&pool).await.unwrap();
+        sqlx::query("INSERT INTO devices (id, name, udid, ip, pairing_blob) VALUES ('phone', 'Test', 'TEST', '127.0.0.1', X'00')")
+            .execute(&pool).await.unwrap();
+        sqlx::query("INSERT INTO apple_accounts (id, apple_id, session_blob) VALUES ('account', 'test@example.invalid', X'00')")
+            .execute(&pool).await.unwrap();
+        pool
+    }
+
+    async fn app(pool: &SqlitePool, id: &str, installed: i64, expires: Option<i64>) {
+        sqlx::query("INSERT INTO apps (id, device_id, bundle_id, display_name, ipa_path, account_id, installed_at, profile_expires_at)
+                     VALUES (?, 'phone', ?, ?, 'test.ipa', 'account', ?, ?)")
+            .bind(id).bind(id).bind(id).bind(installed).bind(expires)
+            .execute(pool).await.unwrap();
+    }
+
+    #[tokio::test]
+    async fn profile_expiration_controls_the_three_day_window() {
+        let pool = database().await;
+        app(&pool, "legacy_due", NOW - 4 * DAY - 1, None).await;
+        app(&pool, "legacy_boundary", NOW - 4 * DAY, None).await;
+        app(&pool, "exact_due", NOW - DAY, Some(NOW + 3 * DAY - 1)).await;
+        app(&pool, "exact_boundary", NOW - 5 * DAY, Some(NOW + 3 * DAY)).await;
+        app(&pool, "exact_future", NOW - 5 * DAY, Some(NOW + 4 * DAY)).await;
+        let due = apps_needing_refresh(&pool, NOW, 3, RETRY).await.unwrap();
+        assert_eq!(due.len(), 2);
+        assert!(due.iter().any(|app| app.id == "legacy_due"));
+        assert!(due.iter().any(|app| app.id == "exact_due"));
+
+        mark_app_installed(&pool, "exact_due", "exact_due", Some(("TEAM", "ABC")), NOW + 6 * DAY)
+            .await.unwrap();
+        mark_app_installed(&pool, "exact_due", "exact_due", None, NOW + 7 * DAY)
+            .await.unwrap();
+        let stored: (i64, String) = sqlx::query_as(
+            "SELECT profile_expires_at, signing_serial FROM apps WHERE id = 'exact_due'",
+        ).fetch_one(&pool).await.unwrap();
+        assert_eq!(stored, (NOW + 7 * DAY, "ABC".into()));
+        assert_eq!(apps_needing_refresh(&pool, NOW, 3, RETRY).await.unwrap().len(), 1);
+    }
+
+    #[tokio::test]
+    async fn pairing_failure_does_not_block_next_poll_and_history_is_coalesced() {
+        let pool = database().await;
+        app(&pool, "due", NOW - 5 * DAY, Some(NOW + DAY)).await;
+        let pairing = format!("{PAIRING_UNREACHABLE} Test TCP failure");
+        record_unreachable_refresh(&pool, "due", &pairing, NOW, RETRY).await.unwrap();
+        record_unreachable_refresh(&pool, "due", &pairing, NOW + 300, RETRY).await.unwrap();
+        assert_eq!(apps_needing_refresh(&pool, NOW + 300, 3, RETRY).await.unwrap().len(), 1);
+        let count: i64 = sqlx::query_scalar("SELECT count(*) FROM jobs")
+            .fetch_one(&pool).await.unwrap();
+        assert_eq!(count, 1);
+        record_unreachable_refresh(&pool, "due", &pairing, NOW + RETRY, RETRY).await.unwrap();
+        let count: i64 = sqlx::query_scalar("SELECT count(*) FROM jobs")
+            .fetch_one(&pool).await.unwrap();
+        assert_eq!(count, 2);
+
+        insert_job(&pool, "job", "due", "refresh").await.unwrap();
+        assert!(apps_needing_refresh(&pool, NOW + 300, 3, RETRY).await.unwrap().is_empty());
+        sqlx::query("UPDATE jobs SET status = 'failed', error = 'Apple service unavailable', finished_at = ? WHERE id = 'job'")
+            .bind(NOW).execute(&pool).await.unwrap();
+        assert!(apps_needing_refresh(&pool, NOW + 300, 3, RETRY).await.unwrap().is_empty());
+        assert_eq!(apps_needing_refresh(&pool, NOW + RETRY, 3, RETRY).await.unwrap().len(), 1);
+    }
+}
