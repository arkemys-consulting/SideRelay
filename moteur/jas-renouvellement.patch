+
+fn ensure_profile_validity(expiration: plist::Date) -> anyhow::Result<()> {
+    let expiration: std::time::SystemTime = expiration.into();
+    let remaining = expiration.duration_since(std::time::SystemTime::now()).unwrap_or_default();
+    // The scheduler first retries four days after a successful install or refresh.
+    anyhow::ensure!(
+        remaining >= std::time::Duration::from_secs(5 * 24 * 60 * 60),
+        "Apple did not return a provisioning profile valid for at least five days"
+    );
+    Ok(())
+}
+
+fn validate_signed_profile(app: &std::path::Path) -> anyhow::Result<()> {
+    let bytes = std::fs::read(app.join("embedded.mobileprovision"))?;
+    let profile = apple_codesign_quick::ProvisioningProfile::parse(&bytes)
+        .map_err(|error| anyhow::anyhow!("Invalid signed provisioning profile: {error}"))?;
+    let expiration = profile.plist().get("ExpirationDate")
+        .and_then(plist::Value::as_date)
+        .ok_or_else(|| anyhow::anyhow!("The signed provisioning profile has no expiration date"))?;
+    ensure_profile_validity(expiration)
+}
