+fn active_shared_id(info: &sideload::IpaInfo, team: &str, ids: &[isideload::dev::app_ids::AppId]) -> Option<String> {
+    info.shared_ios_identifier(team).filter(|shared| ids.iter().any(|id| &id.identifier == shared &&
+        id.expiration_date.is_none_or(|date| std::time::SystemTime::from(date) > std::time::SystemTime::now())))
+}
+
+pub async fn check_tvos_app_id(state: &AppState, account: &str, info: &sideload::IpaInfo, identifier: &str) -> anyhow::Result<()> {
+    let _signing = state.signing.lock().await;
+    let mut apple = AppleContext::open(state, account).await?;
+    let report = apple.session.list_app_ids(&apple.team, None).await.map_err(sideload::signing_error)?;
+    ensure!(active_shared_id(info, &apple.team.team_id, &report.app_ids).as_deref() == Some(identifier),
+        "Apple no longer lists a matching App ID for reuse. Review App IDs again.");
+    Ok(())
 }
 
