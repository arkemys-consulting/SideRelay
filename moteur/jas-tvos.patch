diff --git a/src/server/tvos.rs b/src/server/tvos.rs
new file mode 100644
index 0000000..f03a501
--- /dev/null
+++ b/src/server/tvos.rs
@@ -0,0 +1,111 @@
+use std::{collections::HashSet, ffi::OsStr, path::Path, process::Command};
+
+use anyhow::{Context, ensure};
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+
+use super::{db::DeviceRow, sideload::PairingUnreachable};
+
+pub const DISCOVERY: &str = "coredevice-tvos";
+
+#[derive(Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct AppleTv {
+    pub udid: String,
+    pub name: String,
+    pub os_version: String,
+}
+
+async fn devicectl(args: Vec<std::ffi::OsString>, timeout: &'static str) -> anyhow::Result<Value> {
+    tokio::task::spawn_blocking(move || {
+        #[cfg(target_os = "macos")]
+        let mut command = {
+            let mut command = Command::new("/usr/bin/xcrun");
+            command.arg("devicectl");
+            command
+        };
+        #[cfg(not(target_os = "macos"))]
+        let mut command = {
+            let mut command = Command::new("/usr/bin/python3");
+            command.args(["-B", "/opt/siderelay/Interface/CoreDeviceDocker.py"]);
+            command
+        };
+        let output = command
+            .args(args)
+            .args(["--quiet", "--timeout", timeout, "--json-output", "/dev/stdout"])
+            .output().context("Could not start Xcode’s devicectl")?;
+        let json: Option<Value> = serde_json::from_slice(&output.stdout).ok();
+        ensure!(output.status.success(), "{}", json.as_ref().and_then(|json| {
+            json.pointer("/error/userInfo/NSLocalizedDescription").and_then(Value::as_str)
+        }).map(str::to_owned).unwrap_or_else(|| {
+            let stderr = String::from_utf8_lossy(&output.stderr);
+            if stderr.trim().is_empty() {
+                format!("Xcode’s devicectl failed ({})", output.status)
+            } else {
+                stderr.trim().chars().take(3000).collect()
+            }
+        }));
+        json.and_then(|mut json| json.get_mut("result").map(Value::take))
+            .context("Xcode did not return the expected device information.")
+    }).await?
+}
+
+pub async fn discover() -> anyhow::Result<Vec<AppleTv>> {
+    let result = devicectl(["list", "devices"].map(Into::into).into(), "8").await?;
+    let devices = result["devices"].as_array().context("Xcode did not return a device list.")?;
+    Ok(devices.iter().filter_map(|device| {
+        let hardware = &device["hardwareProperties"];
+        let connection = &device["connectionProperties"];
+        let properties = &device["deviceProperties"];
+        if hardware["platform"] != "tvOS" || connection["pairingState"] != "paired"
+            || connection["transportType"] != "localNetwork" {
+            return None;
+        }
+        let udid = hardware["udid"].as_str().filter(|udid| !udid.is_empty())?;
+        Some(AppleTv {
+            udid: udid.to_owned(),
+            name: properties["name"].as_str().unwrap_or("Apple TV").to_owned(),
+            os_version: properties["osVersionNumber"].as_str().unwrap_or("").to_owned(),
+        })
+    }).collect())
+}
+
+pub async fn register(state: &super::state::AppState, udid: &str) -> anyhow::Result<()> {
+    let tv = discover().await?.into_iter().find(|tv| tv.udid == udid)
+        .context("Pair the Apple TV with this Mac in Xcode and try again.")?;
+    sqlx::query(
+        "INSERT INTO devices (id, name, udid, ip, port, pairing_blob, discovery)
+         VALUES (?, ?, ?, '', 0, X'', ?) ON CONFLICT(udid) DO NOTHING",
+    ).bind(uuid::Uuid::new_v4().to_string()).bind(tv.name).bind(tv.udid).bind(DISCOVERY)
+        .execute(&state.db).await?;
+    Ok(())
+}
+
+async fn command(
+    device: &DeviceRow, subcommand: &[&str], argument: Option<&OsStr>, timeout: &'static str,
+) -> anyhow::Result<Value> {
+    let mut args: Vec<_> = subcommand.iter().map(std::ffi::OsString::from).collect();
+    args.extend(["--device".into(), device.udid.clone().into()]);
+    args.extend(argument.map(OsStr::to_os_string));
+    devicectl(args, timeout).await
+}
+
+pub async fn installed_apps(device: &DeviceRow) -> anyhow::Result<HashSet<String>> {
+    let result = command(device, &["device", "info", "apps"], None, "12").await
+        .map_err(|error| PairingUnreachable(format!("Check that the Apple TV is awake and reachable on the local network. {error:#}")))?;
+    let apps = result["apps"].as_array().context("Xcode did not return the list of installed tvOS apps.")?;
+    apps.iter().map(|app| app["bundleIdentifier"].as_str().map(str::to_owned)
+        .context("Xcode did not return the bundle identifier of an installed tvOS app.")).collect()
+}
+
+pub async fn install(device: &DeviceRow, app: &Path) -> anyhow::Result<()> {
+    command(device, &["device", "install", "app"], Some(app.as_os_str()), "300")
+        .await.map_err(|error| anyhow::anyhow!("Could not install on Apple TV: {error:#}"))?;
+    Ok(())
+}
+
+pub async fn uninstall(device: &DeviceRow, bundle_id: &str) -> anyhow::Result<()> {
+    command(device, &["device", "uninstall", "app"], Some(OsStr::new(bundle_id)), "30")
+        .await.map_err(|error| anyhow::anyhow!("Could not uninstall from Apple TV: {error:#}"))?;
+    Ok(())
+}
