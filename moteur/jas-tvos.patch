+#[server(endpoint = "/apple_tv_devices11318273670462819093")]
+pub async fn apple_tv_devices(udid: Option<String>) -> Result<serde_json::Value, ServerFnError> {
+    let headers: axum::http::HeaderMap = leptos_axum::extract().await?;
+    if headers.get("X-SideRelay-Device").and_then(|value| value.to_str().ok()) != Some("1") {
+        return Err(ServerFnError::new("Manage Apple TV in SideRelay."));
+    }
+    use crate::server::{tvos, state::AppState};
+    let state = leptos::prelude::use_context::<AppState>().ok_or_else(|| ServerFnError::new("No state"))?;
+    if let Some(udid) = udid {
+        tvos::register(&state, &udid).await.map_err(|error| ServerFnError::new(error.to_string()))?;
+        return Ok(serde_json::Value::Null);
+    }
+    let devices = tvos::discover().await.map_err(|error| ServerFnError::new(error.to_string()))?;
+    Ok(serde_json::to_value(devices).map_err(|error| ServerFnError::new(error.to_string()))?)
+}
