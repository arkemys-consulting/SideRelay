+#[cfg(all(test, feature = "ssr"))]
+mod two_factor_prompt_tests {
+    use super::TwoFactorPrompt;
+    use isideload::auth::apple_account::{TrustedNumber, TwoFactorCallbackParams};
+
+    #[test]
+    fn sms_verification_keeps_apples_error_and_selected_number() {
+        let prompt = TwoFactorPrompt::from(TwoFactorCallbackParams {
+            last_error: Some("The code was incorrect.".into()),
+            unknown: false,
+            sms: true,
+            numbers: vec![TrustedNumber {
+                id: 7,
+                number_with_dial_code: "+1 (•••) •••-••89".into(),
+                last_two_digits: "89".into(),
+                push_mode: "sms".into(),
+            }],
+            selected_number_id: Some(7),
+        });
+        let value = serde_json::to_value(prompt).unwrap();
+        assert_eq!(value["last_error"], "The code was incorrect.");
+        assert_eq!(value["selected_number_id"], 7);
+        assert_eq!(value["sms"], true);
+        assert_eq!(value["unknown"], false);
+    }
+
+    #[test]
+    fn prompts_from_older_engines_remain_readable() {
+        let prompt: TwoFactorPrompt = serde_json::from_value(serde_json::json!({
+            "unknown": false, "sms": true, "numbers": [], "selected_number_id": 7
+        })).unwrap();
+        assert!(prompt.last_error.is_none());
+        assert_eq!(prompt.selected_number_id, Some(7));
+    }
+}
