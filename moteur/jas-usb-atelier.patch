diff --git a/src/server/export.rs b/src/server/export.rs
new file mode 100644
index 0000000..fa33d89
--- /dev/null
+++ b/src/server/export.rs
@@ -0,0 +1,76 @@
+use std::net::SocketAddr;
+use std::path::PathBuf;
+
+use axum::{
+    body::Bytes,
+    extract::ConnectInfo,
+    http::{header, HeaderMap, StatusCode},
+    response::{IntoResponse, Response},
+};
+use tokio::io::AsyncWriteExt;
+
+use super::{db, sideload, state::AppState};
+
+struct Scratch(PathBuf);
+
+impl Drop for Scratch {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_file(&self.0);
+    }
+}
+
+pub async fn export_ipa(
+    state: AppState,
+    ConnectInfo(peer): ConnectInfo<SocketAddr>,
+    headers: HeaderMap,
+    bytes: Bytes,
+) -> Response {
+    if !peer.ip().is_loopback()
+        || headers.contains_key(header::ORIGIN)
+        || !headers.get(header::HOST).and_then(|host| host.to_str().ok())
+            .is_some_and(|host| host.split_once(':').is_some_and(|(name, _)| name == "127.0.0.1"))
+        || headers.get(header::CONTENT_TYPE).and_then(|v| v.to_str().ok()) != Some("application/octet-stream")
+    {
+        return StatusCode::FORBIDDEN.into_response();
+    }
+    let parse_id = |name| headers.get(name).and_then(|value| value.to_str().ok())
+        .filter(|value| uuid::Uuid::parse_str(value).is_ok());
+    let (Some(device_id), Some(account_id)) = (
+        parse_id("x-siderelay-device"), parse_id("x-siderelay-account"),
+    ) else {
+        return (StatusCode::BAD_REQUEST, "Select a registered device and an Apple Account.").into_response();
+    };
+
+    let result = async {
+        let _lock = state.signing.lock().await;
+        let device = db::get_device(&state.db, device_id).await?
+            .ok_or_else(|| anyhow::anyhow!("This device is no longer registered in SideRelay."))?;
+        let (apple_id, session_blob): (String, Vec<u8>) = sqlx::query_as(
+            "SELECT apple_id, session_blob FROM apple_accounts WHERE id = ?",
+        ).bind(account_id).fetch_optional(&state.db).await?
+            .ok_or_else(|| anyhow::anyhow!("This Apple Account is no longer registered in SideRelay."))?;
+        anyhow::ensure!(bytes.starts_with(b"PK\x03\x04"), "Choose a valid IPA file.");
+        let directory = PathBuf::from(&state.config.storage.ipa_dir);
+        tokio::fs::create_dir_all(&directory).await?;
+        let scratch = Scratch(directory.join(format!(".export-{}.ipa", uuid::Uuid::new_v4())));
+        {
+            let mut file = tokio::fs::OpenOptions::new().create_new(true).write(true)
+                .mode(0o600).open(&scratch.0).await?;
+            file.write_all(&bytes).await?;
+            file.flush().await?;
+        }
+        drop(bytes);
+        let anisette = state.anisette_url.read().await.clone();
+        sideload::prepare_signed_ipa(
+            &state.db, &state.crypto, &apple_id, &session_blob, &device,
+            scratch.0.to_str().ok_or_else(|| anyhow::anyhow!("Could not open the temporary IPA."))?,
+            None, &anisette, true, || {},
+        ).await
+    }.await;
+
+    match result {
+        Ok(ipa) => ([(header::CONTENT_TYPE, "application/octet-stream"),
+                      (header::CACHE_CONTROL, "no-store")], ipa.bytes).into_response(),
+        Err(error) => (StatusCode::UNPROCESSABLE_ENTITY, error.to_string()).into_response(),
+    }
+}
