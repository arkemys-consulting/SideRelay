+pub fn archive_has_extensions(path: &str) -> anyhow::Result<bool> {
+    let archive = zip::ZipArchive::new(std::fs::File::open(path)?)?;
+    let found = archive.file_names().any(|name| {
+        let mut parts = name.split('/');
+        parts.next() == Some("Payload")
+            && parts.next().is_some_and(|part| part.ends_with(".app"))
+            && matches!(parts.next(), Some("PlugIns" | "Extensions"))
+            && parts.next().is_some_and(|part| part.ends_with(".appex"))
+    });
+    Ok(found)
 }
 
