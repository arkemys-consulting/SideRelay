MAGIE = b"RPPairing"
ACTIVITE_TERMINEE = "('done', 'failed', 'cancelled', 'canceled')"


def pairs_tailscale():
    statut = json.loads(subprocess.check_output(
        [TAILSCALE, "status", "--json"], stderr=subprocess.DEVNULL, timeout=5,
        env={**os.environ, "TAILSCALE_BE_CLI": "1"}
    ))
    if statut.get("BackendState") != "Running":
        raise ValueError("Tailscale est arrêté sur le Mac.")

    moi = statut["Self"]
    iphones = [
        appareil for appareil in (statut.get("Peer") or {}).values()
        if appareil.get("OS") == "iOS" and appareil.get("UserID") == moi["UserID"]
    ]
    return moi, iphones


def adresse_tailscale(nom=None):
    moi, iphones = pairs_tailscale()
    if nom:
        iphones = [
            appareil for appareil in iphones
            if nom.rstrip(".").casefold() in (
                appareil.get("HostName", "").casefold(),
                appareil.get("DNSName", "").rstrip(".").casefold(),
            )
        ]
    if len(iphones) != 1:
        raise ValueError("Indique l’iPhone avec --iphone et son nom dans Tailscale.")

    iphone = iphones[0]
    if not iphone.get("Online"):
        raise ValueError("L’iPhone est hors ligne dans Tailscale.")
    adresse = next((
        ip for ip in iphone["TailscaleIPs"] if ipaddress.ip_address(ip).version == 4
    ), None)
    if adresse is None:
        raise ValueError("L’iPhone n’a pas d’adresse IPv4 Tailscale.")

    return adresse, moi["TailscaleIPs"]


def diagnostic(nom, afficher_adresse):
    adresse, adresses_mini = adresse_tailscale(nom)
    requete = {"handshake": {"_0": {
        "hostOptions": {"attemptPairVerify": True},
        "wireProtocolVersion": 19,
    }}}
    corps = json.dumps({
        "originatedBy": "host",
        "sequenceNumber": 0,
        "message": {"plain": {"_0": {"request": {"_0": requete}}}},
    }).encode()
    with socket.create_connection((adresse, 49152), timeout=4) as lien:
        if lien.getsockname()[0] not in adresses_mini:
            raise ValueError("La connexion ne passe pas par l’interface Tailscale.")
        lien.sendall(MAGIE + struct.pack(">H", len(corps)) + corps)
        with lien.makefile("rb") as lecture:
            if lecture.read(len(MAGIE)) != MAGIE:
                raise ValueError("Le port répond, mais la réponse Apple est inattendue.")
            taille, = struct.unpack(">H", lecture.read(2))
            reponse = json.loads(lecture.read(taille))
    if not isinstance(reponse["message"]["plain"]["_0"]["response"]["_1"]["handshake"]["_0"], dict):
        raise ValueError("Le port répond, mais la réponse Apple est inattendue.")
    print("L’iPhone répond au protocole Remote Pairing via Tailscale.")
    if afficher_adresse:
        print(adresse)


def preparer_donnees():
    os.umask(0o077)
    DONNEES.mkdir(mode=0o700, parents=True, exist_ok=True)
    if DONNEES.is_symlink() or DONNEES.stat().st_mode & 0o077:
        raise ValueError("SideRelay’s data folder must be private (permissions 700).")
    IDENTITES_SIGNATURE.mkdir(mode=0o700, exist_ok=True)
    if IDENTITES_SIGNATURE.is_symlink() or IDENTITES_SIGNATURE.stat().st_mode & 0o077:
        raise ValueError("SideRelay’s signing identities folder must be private (permissions 700).")
    if not MOTEUR.is_file() or not SITE.is_dir():
        raise ValueError("The signing engine or its web resources are missing. Reinstall the complete Mac package.")


MODES = ("tailscale", "bonjour")


def mode_connexion():
    try:
        mode = (DONNEES / "connexion").read_text(encoding="ascii").strip()
    except FileNotFoundError:
        legacy = DONNEES == RACINE / "donnees" or os.environ.get("SIDERELAY_LEGACY_LAUNCH_AGENT") == "1"
        return "tailscale" if legacy else "bonjour"
    if mode not in MODES:
        raise ValueError("Invalid connection preference.")
    return mode


def ecrire_atomique(chemin, texte):
    with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=DONNEES,
                                     delete=False) as fichier:
        temporaire = Path(fichier.name)
        try:
            fichier.write(texte)
            fichier.close()
            temporaire.replace(chemin)
        finally:
            temporaire.unlink(missing_ok=True)


def connexion_db(lecture=True):
    uri = (DONNEES / "signature.db").as_uri()
    db = sqlite3.connect(uri + ("?mode=ro" if lecture else "?mode=rw"), uri=True, timeout=2)
    if os.environ.get("SIDERELAY_ENCRYPT_ACCOUNT_NAMES") == "1":
        from Interface.SecuriteDocker import account_reader
        account_reader(db, Path(os.environ["JAS_SECRET_KEY_FILE"]))
    else:
        db.create_function("apple_account_name", 1, lambda name: name, deterministic=True)
    return closing(db)


def etat_portail():
    etat = {"mode": mode_connexion(), "devices": 0, "accounts": 0, "apps": 0}
    if (DONNEES / "signature.db").is_file():
        with connexion_db() as db:
            for cle, table in (("devices", "devices"), ("accounts", "apple_accounts")):
                etat[cle], = db.execute(f"SELECT count(*) FROM {table}").fetchone()
            etat["apps"], = db.execute("SELECT count(*) FROM apps WHERE installed_at IS NOT NULL").fetchone()
            if etat["devices"] == 1:
                identifiant, adresse = db.execute("SELECT id, ip FROM devices").fetchone()
                etat["device"] = str(identifiant)
                try:
                    etat["recommendedConnection"] = "tailscale" if ipaddress.ip_address(adresse) in ipaddress.ip_network("100.64.0.0/10") else "bonjour"
                except ValueError:
                    pass
    return etat


def cibles_signature():
    if not (DONNEES / "signature.db").is_file():
        return {"devices": [], "accounts": []}
    with connexion_db() as db:
        db.row_factory = sqlite3.Row
        return {
            "devices": [dict(row) for row in db.execute("SELECT id, name FROM devices ORDER BY lower(name)")],
            "accounts": [dict(row) for row in db.execute(
                "SELECT id, apple_account_name(apple_id) AS name FROM apple_accounts ORDER BY lower(name)"
            )],
            "deviceUDIDs": dict(db.execute("SELECT id, udid FROM devices WHERE udid IS NOT NULL")),
        }


def catalogue_apps():
    if not (DONNEES / "signature.db").is_file():
        return []
    with connexion_db() as db:
        db.row_factory = sqlite3.Row
        lignes = db.execute("""
            SELECT a.id, a.display_name AS name, a.bundle_id AS bundleID, a.version,
                   a.installed_at AS installedAt, a.last_refreshed AS refreshedAt,
                   COALESCE(a.profile_expires_at, COALESCE(a.last_refreshed, a.installed_at) + 7 * 86400) AS profileExpiresAt,
                   a.refresh_enabled AS autoRefresh, d.id AS deviceID, d.name AS device,
                   d.discovery = 'coredevice-tvos' AS appleTV,
                   a.ipa_path AS storedIPA, c.id IS NOT NULL AS canRefresh,
                   a.profile_details AS profileDetails, a.signed_extension_ids AS signedExtensionIDs,
                   a.use_main_profile AS useMainProfile,
                   c.id AS accountID, c.team_id AS accountTeam, a.signing_serial AS signingSerial,
                   package.id AS packageID, package.metadata AS packageMetadata,
                   apple_account_name(c.apple_id) AS account, installation.status AS installStatus, installation.id AS installJobID,
                   (SELECT j.kind FROM jobs AS j
                    WHERE j.app_id = a.id AND j.status IN ('queued', 'running', 'pending')
                    ORDER BY j.rowid DESC LIMIT 1) AS activeJob,
                   a.signing_repair AS signingRepair, latest.id AS latestJobID,
                   latest.kind AS latestJobKind, latest.error AS latestError
            FROM apps AS a
            LEFT JOIN devices AS d ON a.device_id = d.id
            LEFT JOIN apple_accounts AS c ON a.account_id = c.id
            LEFT JOIN ipa_packages AS package ON a.ipa_path = package.path
            LEFT JOIN jobs AS installation ON installation.rowid = (
                SELECT j.rowid FROM jobs AS j
                WHERE j.app_id = a.id AND j.kind = 'install'
                ORDER BY j.rowid DESC LIMIT 1
            )
            LEFT JOIN jobs AS latest ON latest.rowid = (
                SELECT j.rowid FROM jobs AS j WHERE j.app_id = a.id ORDER BY j.rowid DESC LIMIT 1
            )
            ORDER BY lower(coalesce(a.display_name, a.bundle_id)), lower(coalesce(d.name, '')), a.id
        """)
        apps = []
        for ligne in lignes:
            app = dict(ligne)
            archive = app.pop("storedIPA")
            for field in ("profileDetails", "signedExtensionIDs", "packageMetadata"):
                value = app[field]
                app[field] = json.loads(value) if value else None
            app["ipaPresent"] = bool(archive and (DONNEES / archive).is_file())
            app["canRefresh"] = bool(app["canRefresh"] and app["ipaPresent"])
            apps.append(app)
        return apps


def retirer_tentative(app_id):
    with connexion_db(lecture=False) as db, db:
        db.execute("PRAGMA foreign_keys = ON")
        resultat = db.execute("""
            DELETE FROM apps WHERE id = ? AND installed_at IS NULL
              AND NOT EXISTS (SELECT 1 FROM jobs WHERE app_id = apps.id
                              AND status IN ('queued', 'running', 'pending', 'done'))
        """, (app_id,))
        return {"removed": resultat.rowcount == 1}


def activite():
    with connexion_db() as db:
        db.row_factory = sqlite3.Row
        db.execute("BEGIN")
        filtre = "1"
        if db.execute("SELECT 1 FROM sqlite_schema WHERE name = 'activity_cleared'").fetchone():
            filtre = "NOT EXISTS (SELECT 1 FROM activity_cleared AS c WHERE c.job_id = j.id)"
        lignes = db.execute(f"""
            SELECT j.id, a.id AS app_id, a.account_id, a.display_name AS app_name, a.device_id, d.name AS device_name,
                   (j.kind <> 'install' AND a.ipa_path IS NOT NULL OR j.install_ipa_path IS NOT NULL) AS can_retry,
                   NOT EXISTS (SELECT 1 FROM jobs newer WHERE newer.app_id=a.id AND newer.rowid>j.rowid) AS latest,
                   j.kind, j.status, j.error, j.started_at, j.finished_at, j.progress, j.stage
            FROM jobs AS j JOIN apps AS a ON a.id = j.app_id JOIN devices AS d ON d.id = a.device_id
            WHERE {filtre}
            ORDER BY CASE j.status WHEN 'running' THEN 0 WHEN 'queued' THEN 1 ELSE 2 END,
                     j.rowid DESC LIMIT 20
        """).fetchall()
        effacable, = db.execute(f"""
            SELECT EXISTS (SELECT 1 FROM jobs AS j WHERE {filtre} AND j.status IN {ACTIVITE_TERMINEE})
        """).fetchone()
        return {"jobs": [dict(ligne) for ligne in lignes], "canClear": bool(effacable)}


def effacer_activite():
    with connexion_db(lecture=False) as db, db:
        db.execute("PRAGMA foreign_keys = ON")
        db.execute("""CREATE TABLE IF NOT EXISTS activity_cleared (
            job_id TEXT PRIMARY KEY NOT NULL REFERENCES jobs(id) ON DELETE CASCADE
        )""")
        resultat = db.execute(f"""
            INSERT OR IGNORE INTO activity_cleared (job_id)
            SELECT id FROM jobs WHERE status IN {ACTIVITE_TERMINEE}
        """)
        return {"cleared": resultat.rowcount}


def appareils_usb(enrichir=True):
    arbre = plistlib.loads(subprocess.check_output(
        ["/usr/sbin/ioreg", "-a", "-p", "IOUSB", "-l", "-w0"],
        stderr=subprocess.DEVNULL, timeout=4,
    ))
    appareils = []

    def parcourir(noeuds):
        for noeud in noeuds:
            produit = noeud.get("USB Product Name", "")
            if noeud.get("idVendor") == 0x05AC and produit in ("iPhone", "iPad"):
                appareils.append({"name": produit, "id": str(noeud.get("locationID", len(appareils))),
                                  "serial": noeud.get("USB Serial Number", "")})
            parcourir(noeud.get("IORegistryEntryChildren", []))

    parcourir(arbre if isinstance(arbre, list) else [arbre])
    if appareils and enrichir:
        # Xcode is optional. The USB list still works before Trust and without Xcode.
        try:
            liste = json.loads(subprocess.check_output([
                "/usr/bin/xcrun", "devicectl", "list", "devices", "--quiet", "--timeout", "5",
                "--json-output", "-",
            ], stderr=subprocess.DEVNULL, timeout=3))["result"]["devices"]
            def identifiant(valeur):
                return str(valeur).replace("-", "").upper()
            noms = {}
            for appareil in liste:
                materiel = appareil.get("hardwareProperties", {})
                if appareil.get("connectionProperties", {}).get("transportType") != "wired":
                    continue
                for cle in ("udid", "serialNumber"):
                    if materiel.get(cle) and (nom := appareil.get("deviceProperties", {}).get("name")):
                        noms[identifiant(materiel[cle])] = nom
            for appareil in appareils:
                appareil["name"] = noms.get(identifiant(appareil["serial"]), appareil["name"])
        except (OSError, subprocess.SubprocessError, ValueError, KeyError, TypeError):
            pass
    return [{"name": a["name"], "id": a["serial"]} for a in appareils]


def appareils_tailscale():
    _, pairs = pairs_tailscale()
    appareils = []
    for pair in pairs:
        adresse = next((ip for ip in pair.get("TailscaleIPs", []) if ipaddress.ip_address(ip).version == 4), None)
        if adresse:
            nom = pair.get("HostName", "")
            if not nom or nom.casefold() == "localhost":
                nom = pair.get("DNSName", "").split(".", 1)[0]
            appareils.append({"name": nom or "iPhone or iPad", "address": adresse,
                              "online": pair.get("Online") is True})
    return sorted(appareils, key=lambda a: (not a["online"], a["name"].casefold()))


def appareils_enregistres():
    if not (DONNEES / "signature.db").is_file():
        return []
    with connexion_db() as db:
        db.row_factory = sqlite3.Row
        return [dict(ligne) for ligne in db.execute("SELECT name, udid, ip, mdns_ip FROM devices")]


def versions_appareils():
    with connexion_db() as db:
        registered = {udid.replace("-", "").lower(): key for key, udid in db.execute("SELECT id,udid FROM devices")}
    if not registered:
        return {}
    from Interface.CatalogueIPA import private_work
    try:
        with tempfile.TemporaryDirectory(dir=private_work(DONNEES)) as work:
            result = Path(work) / "devices.json"
            subprocess.run(["/usr/bin/xcrun", "devicectl", "list", "devices", "--quiet", "--timeout", "5",
                            "--json-output", str(result)], check=True, capture_output=True, timeout=7)
            devices = json.loads(result.read_text())["result"]["devices"]
    except (OSError, subprocess.SubprocessError, ValueError, KeyError):
        return {}
    versions = {}
    for device in devices:
        udid = (device.get("hardwareProperties", {}).get("udid") or "").replace("-", "").lower()
        version = device.get("deviceProperties", {}).get("osVersionNumber")
        if udid in registered and isinstance(version, str) and re.fullmatch(r"\d+(?:\.\d+)*", version):
            versions[registered[udid]] = version
    return versions


def appareils_detectes():
    def lire(liste):
        try:
            return {"status": "ready", "devices": liste()}
        except (OSError, subprocess.SubprocessError, ValueError, KeyError, TypeError, plistlib.InvalidFileException):
            return {"status": "unavailable", "devices": []}
    with ThreadPoolExecutor(max_workers=2) as groupe:
        usb = groupe.submit(lire, appareils_usb)
        tailscale = groupe.submit(lire, appareils_tailscale)
        return {"usb": usb.result(), "tailscale": tailscale.result(), "registered": appareils_enregistres()}


def outil_jumelage():
    disque = RACINE / "idevice_pair.dmg"
    if not disque.is_file():
        raise ValueError("The pairing tool disk image is missing.")
    hdiutil = ["/usr/bin/hdiutil"]
    info = plistlib.loads(subprocess.check_output(hdiutil + ["info", "-plist"], timeout=10))
    entites = [e for img in info.get("images", []) if img.get("image-path") == str(disque)
               for e in img.get("system-entities", []) if "mount-point" in e]
    if not entites:
        montage = subprocess.check_output(hdiutil + [
            "attach", str(disque), "-readonly", "-nobrowse", "-noautoopen", "-plist"
        ], timeout=35)
        entites = plistlib.loads(montage).get("system-entities", [])
    for e in entites:
        if "mount-point" not in e:
            continue
        volume = Path(e["mount-point"])
        app = volume / "idevice_pair.app"
        if app.is_dir() and app.resolve().parent == volume.resolve():
            return str(app)
    raise ValueError("idevice_pair.app was not found on the disk image.")


def changer_connexion(mode, manuel=False):
    preparer_donnees()
    with (DONNEES / "connexion.lock").open("a") as verrou:
        fcntl.flock(verrou, fcntl.LOCK_EX)
        avant = mode_connexion()
        if avant == mode:
            return {"mode": mode, "restart": False}
        if (DONNEES / "signature.db").is_file():
            with connexion_db() as db:
                # Unknown nonterminal statuses also block a restart.
                actif = db.execute("""
                    SELECT 1 FROM jobs WHERE finished_at IS NULL AND
                    lower(status) NOT IN ('failed', 'completed', 'success', 'succeeded', 'cancelled', 'canceled')
                    LIMIT 1
                """).fetchone()
                if actif:
                    raise ValueError("Wait for the current signing jobs to finish.")
        service = f"gui/{os.getuid()}/{IDENTIFIANT}"
        launchctl = ["/bin/launchctl"]
        local_launch_agent = DONNEES == RACINE / "donnees" or os.environ.get("SIDERELAY_LEGACY_LAUNCH_AGENT") == "1"
        gere = local_launch_agent and subprocess.run(launchctl + ["print", service], stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL, timeout=4).returncode == 0
        if not gere and not manuel:
            raise ValueError("Restart SideRelay with its background service to change the connection.")
        chemin = DONNEES / "connexion"
        ecrire_atomique(chemin, mode + "\n")
        if gere:
            try:
                subprocess.run(launchctl + ["kickstart", "-k", service], check=True,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=8)
            except (OSError, subprocess.SubprocessError):
                ecrire_atomique(chemin, avant + "\n")
                raise ValueError("The signing service could not restart. The previous connection was restored.")
        return {"mode": mode, "restart": not gere}


def servir(journal=False, no_mdns=False):
    from Interface.EngineAccess import token

    preparer_donnees()
    if journal:
        with (DONNEES / "service.log").open("ab") as fichier:
            os.dup2(fichier.fileno(), 1)
            os.dup2(fichier.fileno(), 2)
    cle = Path(os.environ.get("JAS_SECRET_KEY_FILE", DONNEES / "cle"))
    if cle == DONNEES / "cle":
        try:
            with cle.open("x", encoding="ascii") as fichier:
                fichier.write(secrets.token_hex(32))
        except FileExistsError:
            pass
    if cle.is_symlink() or cle.stat().st_mode & 0o077:
        raise ValueError("La clé du service doit être un fichier privé, avec les droits 600.")

    config = DONNEES / "jas.toml"
    mdns_enabled = not no_mdns and mode_connexion() == "bonjour"
    if not mdns_enabled and (DONNEES / "signature.db").is_file():
        with connexion_db(lecture=False) as db, db:
            colonnes = {ligne[1] for ligne in db.execute("PRAGMA table_info(devices)")}
            if {"mdns_ip", "mdns_seen_at"} <= colonnes:
                db.execute("""
                    UPDATE devices SET mdns_ip = NULL, mdns_seen_at = NULL
                    WHERE mdns_ip IS NOT NULL OR mdns_seen_at IS NOT NULL
                """)
    ecrire_atomique(config, f"""[server]
bind = "{HOTE}:{PORT}"
log_level = "warn"

[storage]
database_path = "signature.db"
ipa_dir = "ipas"

[scheduler]
interval_hours = 2
reachability_interval_minutes = 5
refresh_window_days = 3
worker_threads = 1

[discovery]
mdns_enabled = {str(mdns_enabled).lower()}
mdns_interface = ""
""")
    travail_signature = DONNEES / "travail-signature"
    travail_signature.mkdir(mode=0o700, exist_ok=True)
    if travail_signature.is_symlink() or travail_signature.stat().st_mode & 0o077:
        raise ValueError("Le dossier de signature doit rester privé.")
    os.chdir(DONNEES)
    host_transport = {key: os.environ[key] for key in (
        "SIDERELAY_HOST_DISCOVERY", "SIDERELAY_HOST_TVOS", "SIDERELAY_DISCOVERY_PORT", "SIDERELAY_DISCOVERY_TOKEN",
        "SIDERELAY_ENCRYPT_ACCOUNT_NAMES",
    ) if key in os.environ}
    os.execve(MOTEUR, [str(MOTEUR)], {
        **host_transport,
        "PATH": "/usr/bin:/bin",
        "TMPDIR": str(travail_signature),
        "JAS_CONFIG": str(config),
        "JAS_SECRET_KEY_FILE": str(cle),
        "SIDERELAY_ALTSERVER_CERTIFICATES_DIR": str(IDENTITES_SIGNATURE),
        "SIDERELAY_IPA_INBOX_DIR": os.environ.get("SIDERELAY_IPA_INBOX_DIR", str(DONNEES.parent / "IPA-Inbox")),
        "SIDERELAY_IPA_INBOX_CONFIG": str(DONNEES / "ipa-inbox-folder"),
        "LEPTOS_OUTPUT_NAME": "jas",
        "LEPTOS_SITE_ROOT": str(SITE),
        "LEPTOS_SITE_ADDR": f"{HOTE}:{PORT}",
        "SIDERELAY_ENGINE_TOKEN": token(cle),
    })


def activer():
    preparer_donnees()
    agent = Path.home() / "Library/LaunchAgents" / f"{IDENTIFIANT}.plist"
    agent.parent.mkdir(exist_ok=True)
    domaine = f"gui/{os.getuid()}"
    service = f"{domaine}/{IDENTIFIANT}"
    statut = subprocess.run(["/bin/launchctl", "print", service],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if statut.returncode == 0:
        print(f"Service déjà activé. http://{HOTE}:{PORT}")
        return
    with socket.socket() as test:
        if test.connect_ex((HOTE, PORT)) == 0:
            raise ValueError("Le portail tourne déjà. Arrête-le avec Ctrl+C avant l’activation.")

    python = shutil.which("python3", path="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin")
    if not python:
        raise ValueError("Python 3 est introuvable.")
    definition = {
        "Label": IDENTIFIANT,
        "ProgramArguments": [python, str(RACINE / "signature-ios"), "servir", "--journal"],
        "RunAtLoad": True,
        "KeepAlive": True,
        "ThrottleInterval": 30,
    }
    if agent.exists():
        if agent.is_symlink() or plistlib.loads(agent.read_bytes()) != definition:
            raise ValueError("Un autre fichier existe déjà pour ce service.")
    else:
        with agent.open("xb") as fichier:
            plistlib.dump(definition, fichier)
    subprocess.run(["/bin/launchctl", "bootstrap", domaine, str(agent)], check=True)
    print(f"Service activé pour ta session macOS. http://{HOTE}:{PORT}")


def desactiver():
    agent = Path.home() / "Library/LaunchAgents" / f"{IDENTIFIANT}.plist"
    if not agent.exists():
        print("Service inactif.")
        return
    if agent.is_symlink() or plistlib.loads(agent.read_bytes()).get("ProgramArguments", [])[1:] != [
        str(RACINE / "signature-ios"), "servir", "--journal"
    ]:
        raise ValueError("Ce fichier ne correspond pas à Signature iOS.")
    service = f"gui/{os.getuid()}/{IDENTIFIANT}"
    statut = subprocess.run(["/bin/launchctl", "print", service],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if statut.returncode == 0:
        subprocess.run(["/bin/launchctl", "bootout", service], check=True)
    agent.unlink()
    print("Service arrêté. Les données restent sur le T7.")


