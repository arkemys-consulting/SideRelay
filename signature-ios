    try:
        if options.action == "diagnostic":
            diagnostic(options.iphone, options.adresse)
        elif options.action == "servir":
            servir(options.journal, no_mdns=options.no_mdns)
        elif options.action == "activer":
            activer()
        elif options.action == "desactiver":
            desactiver()
        elif options.action == "service-check":
            detail = {}
            try:
                preparer_donnees()
                mode_connexion()
                for nom, dossier in (("cle", False), ("travail-signature", True)):
                    fichier = DONNEES / nom
                    if fichier.is_symlink() or (fichier.exists() and (
                        fichier.stat().st_mode & 0o077 or (fichier.is_dir() if not dossier else not fichier.is_dir())
                    )):
                        raise ValueError("SideRelay’s local signing files must be private (permissions 600 for files and 700 for folders).")
                cle = DONNEES / "cle"
                if cle.exists():
                    try:
                        valeur = cle.read_text(encoding="ascii")
                        if len(valeur) != 64 or len(bytes.fromhex(valeur)) != 32:
                            raise ValueError()
                    except ValueError as erreur:
                        raise ValueError("SideRelay’s local signing key is invalid. Restore it from your backup.") from erreur
            except OSError:
                detail["error"] = "SideRelay cannot read or create its private data folder. Check the folder’s permissions and try again."
            except ValueError as erreur:
                detail["error"] = str(erreur)
            print(json.dumps(detail))
        elif options.action == "setup-usb":
            print(json.dumps(sorted(a["id"] for a in appareils_usb(enrichir=False))))
