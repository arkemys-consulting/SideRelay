    except json.JSONDecodeError:
        parser.exit(1, "Réponse illisible de Tailscale ou du service Remote Pairing.\n")
    except (ValueError, OSError, sqlite3.Error, subprocess.SubprocessError) as erreur:
        parser.exit(1, f"{erreur}\n")


