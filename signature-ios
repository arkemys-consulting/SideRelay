RACINE = Path(__file__).resolve().parent
DONNEES = Path(os.environ.get("SIDERELAY_DATA_DIR", RACINE / "donnees"))
IDENTITES_SIGNATURE = DONNEES / "identites-signature"
TAILSCALE = "/Applications/Tailscale.app/Contents/MacOS/Tailscale"
