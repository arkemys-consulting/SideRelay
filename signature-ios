            from Interface.PremiereApp import verifier
            with connexion_db() as db:
                print(json.dumps(verifier(db, DONNEES, options.destination, options.id, options.bundle)))
        elif options.action == "etat-portail":
            print(json.dumps(etat_portail()))
        elif options.action == "adresse-tailscale":
            print(adresse_tailscale()[0])
        elif options.action == "backup":
            from Interface.Backup import command
            from Interface.CatalogueIPA import private_work
            from zipfile import BadZipFile
            try:
                file = options.archive.resolve() if options.archive else None
                if options.operation != "apply" and (not file or not file.is_relative_to(private_work(DONNEES).resolve())):
                    raise ValueError("Choose a backup from SideRelay Settings.")
                with connexion_db(lecture=options.operation in ("export", "review")) as db:
                    result = command(db, DONNEES, PORT, options.operation, file)
            except (OSError, ValueError, BadZipFile, sqlite3.Error) as error:
                result = {"error": str(error)[:350]}
            print(json.dumps(result))
        elif options.action == "versions-appareils":
            print(json.dumps(versions_appareils()))
        elif options.action == "cibles-signature":
            print(json.dumps(cibles_signature()))
        elif options.action == "ipa-library":
            import http.client
